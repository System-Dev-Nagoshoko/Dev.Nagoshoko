---
import Layout from '../layouts/Layout.astro';
---

<Layout title="スタッフ管理画面 | 整理券システム">
  <!-- 🔒 認証画面（ID・合言葉入力） -->
  <div id="auth-overlay" class="auth-box">
    <div class="auth-card">
      <div class="lock-icon">🔒</div>
      <h2>スタッフ認証</h2>
      <p class="auth-desc">関係者専用のIDと合言葉を入力してください</p>
      
      <!-- 👤 ログインID入力欄 -->
      <input 
        type="text" 
        id="login-id-input" 
        placeholder="ログインID" 
        autocomplete="username" 
      />

      <!-- 🔑 合言葉（パスワード）入力欄 -->
      <input 
        type="password" 
        id="passcode-input" 
        placeholder="合言葉（パスワード）" 
        autocomplete="current-password" 
      />

      <button id="btn-unlock" class="btn-unlock">ログイン</button>
      <p id="auth-error" class="auth-error" style="display: none;">IDまたは合言葉が正しくありません</p>
    </div>
  </div>

  <!-- 📊 管理ダッシュボード本体（認証成功時に表示） -->
  <div id="admin-main" class="admin-container" style="display: none;">
    <header class="admin-header">
      <div class="header-top">
        <div class="tag">STAFF ONLY</div>
        <span id="current-user-badge" class="user-badge">--</span>
      </div>
      <h1>整理券 運行・呼出ダッシュボード</h1>
      <div class="header-actions">
        <button id="btn-refresh" class="btn-refresh">🔄 データ更新</button>
        <button id="btn-lock" class="btn-lock">ログアウト</button>
      </div>
    </header>

    <!-- 📊 統計カード（組数 ＋ 待機人数） -->
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-label">総発券組数</span>
        <span id="stat-total" class="stat-val">0</span>
      </div>
      <div class="stat-card highlight-waiting">
        <span class="stat-label">待機組数 (総人数)</span>
        <div class="stat-val-group">
          <span id="stat-waiting" class="stat-val">0</span>
          <span class="stat-sub-val">(<strong id="stat-waiting-people">0</strong>名)</span>
        </div>
      </div>
      <div class="stat-card highlight-called">
        <span class="stat-label">呼出中 (案内待ち)</span>
        <span id="stat-called" class="stat-val">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">案内完了</span>
        <span id="stat-admitted" class="stat-val">0</span>
      </div>
    </div>

    <!-- ⚡ クイック呼出バー -->
    <div class="quick-call-box">
      <h3>🚀 先頭の番号を呼出</h3>
      <div class="quick-action">
        <p id="next-calling-info">次の待機者: 読み込み中...</p>
        <button id="btn-call-next" class="btn-call-primary" disabled>次の組を呼出</button>
      </div>
    </div>

    <!-- 📋 整理券一覧テーブル -->
    <div class="table-container">
      <h2>整理券一覧</h2>
      <table class="ticket-table">
        <thead>
          <tr>
            <th>番号</th>
            <th>人数</th>
            <th>発行時刻</th>
            <th>状態</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="ticket-list-body">
          <tr><td colspan="5" style="text-align:center;">読み込み中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<script is:inline>
  const BACKEND_ENDPOINT = "https://ticket-api.zinn1019t.workers.dev";

  const authOverlay = document.getElementById("auth-overlay");
  const adminMain = document.getElementById("admin-main");
  const loginIdInput = document.getElementById("login-id-input");
  const passInput = document.getElementById("passcode-input");
  const unlockBtn = document.getElementById("btn-unlock");
  const authError = document.getElementById("auth-error");
  const lockBtn = document.getElementById("btn-lock");
  const currentUserBadge = document.getElementById("current-user-badge");

  const totalEl = document.getElementById("stat-total");
  const waitingEl = document.getElementById("stat-waiting");
  const waitingPeopleEl = document.getElementById("stat-waiting-people");
  const calledEl = document.getElementById("stat-called");
  const admittedEl = document.getElementById("stat-admitted");
  const listBody = document.getElementById("ticket-list-body");
  const nextInfoEl = document.getElementById("next-calling-info");
  const callNextBtn = document.getElementById("btn-call-next");
  const refreshBtn = document.getElementById("btn-refresh");

  function getStaffKey() {
    return sessionStorage.getItem("staff_key") || "";
  }

  function getStaffId() {
    return sessionStorage.getItem("staff_id") || "";
  }

  async function loadData() {
    const staffKey = getStaffKey();
    if (!staffKey) {
      authOverlay.style.display = "flex";
      adminMain.style.display = "none";
      return;
    }

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/list`, {
        headers: { 
          "X-Admin-Key": staffKey,
          "X-Admin-User": getStaffId()
        }
      });

      // 401: 認証失敗（合言葉・IDの不一致）
      if (res.status === 401) {
        sessionStorage.removeItem("staff_key");
        sessionStorage.removeItem("staff_id");
        authOverlay.style.display = "flex";
        adminMain.style.display = "none";
        authError.textContent = "IDまたは合言葉が正しくありません";
        authError.style.display = "block";
        return;
      }

      // 403: システムOFF（GAS等で管理画面が一時停止されている状態）
      if (res.status === 403) {
        const errorData = await res.json().catch(() => ({}));
        authOverlay.style.display = "none";
        adminMain.style.display = "block";
        if (currentUserBadge) {
          currentUserBadge.textContent = `LOGIN: ${getStaffId() || "ADMIN"}`;
        }
        listBody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:30px;color:#dc2626;font-weight:bold;">⚠️ ${errorData.message || "現在管理画面はメンテナンス停止中です"}</td></tr>`;
        nextInfoEl.textContent = "システム停止中";
        callNextBtn.disabled = true;
        return;
      }

      const data = await res.json();
      if (!data.success) throw new Error(data.message);

      authOverlay.style.display = "none";
      adminMain.style.display = "block";
      authError.style.display = "none";

      if (currentUserBadge) {
        currentUserBadge.textContent = `LOGIN: ${getStaffId() || "ADMIN"}`;
      }

      // 統計カード更新
      totalEl.textContent = data.stats.total;
      waitingEl.textContent = data.stats.waiting;
      calledEl.textContent = data.stats.called;
      admittedEl.textContent = data.stats.admitted;

      // 待機中の合計人数を計算
      const waitingHeadcount = (data.tickets || [])
        .filter(t => t.status === "WAITING")
        .reduce((sum, t) => sum + (Number(t.headcount) || 1), 0);
      if (waitingPeopleEl) {
        waitingPeopleEl.textContent = waitingHeadcount;
      }

      renderTable(data.tickets);
      updateQuickCall(data.tickets);
    } catch (e) {
      console.error(e);
      listBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#ef4444;">データの取得に失敗しました</td></tr>`;
    }
  }

  unlockBtn.addEventListener("click", () => {
    const enteredId = loginIdInput.value.trim();
    const enteredKey = passInput.value.trim();
    if (!enteredId || !enteredKey) {
      authError.textContent = "IDと合言葉を両方入力してください";
      authError.style.display = "block";
      return;
    }

    sessionStorage.setItem("staff_id", enteredId);
    sessionStorage.setItem("staff_key", enteredKey);
    passInput.value = "";
    loadData();
  });

  loginIdInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") passInput.focus();
  });

  passInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") unlockBtn.click();
  });

  lockBtn.addEventListener("click", () => {
    sessionStorage.removeItem("staff_key");
    sessionStorage.removeItem("staff_id");
    location.reload();
  });

  function updateQuickCall(tickets) {
    const nextWaiting = (tickets || []).slice().reverse().find(t => t.status === "WAITING") || tickets.find(t => t.status === "WAITING");
    
    if (nextWaiting) {
      const count = nextWaiting.headcount || 1;
      nextInfoEl.innerHTML = `次は <strong>No.${nextWaiting.ticket_number}</strong>（<span class="quick-headcount">${count}名様</span>）です`;
      callNextBtn.disabled = false;
      callNextBtn.onclick = () => updateStatus(nextWaiting.ticket_number, "CALLED", count);
    } else {
      nextInfoEl.textContent = "待機中の来場者はいません";
      callNextBtn.disabled = true;
    }
  }

  function renderTable(tickets) {
    if (!tickets || tickets.length === 0) {
      listBody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:#94a3b8;">発券されたチケットはありません</td></tr>`;
      return;
    }

    listBody.innerHTML = tickets.map(t => {
      let time = "--:--";
      if (t.created_at) {
        const utcIsoString = t.created_at.includes("T") ? t.created_at : t.created_at.replace(" ", "T") + "Z";
        time = new Date(utcIsoString).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      }
      
      const count = t.headcount || 1;
      const countBadge = `<span class="badge headcount-badge">${count}名</span>`;

      let badge = `<span class="badge waiting">待機中</span>`;
      let actionBtns = `
        <button class="btn-sm btn-call" onclick="updateStatus(${t.ticket_number}, 'CALLED', ${count})">呼出</button>
      `;

      if (t.status === "CALLED") {
        badge = `<span class="badge called">呼出中</span>`;
        actionBtns = `
          <button class="btn-sm btn-admit" onclick="updateStatus(${t.ticket_number}, 'ADMITTED', ${count})">入場完了</button>
        `;
      } else if (t.status === "ADMITTED") {
        badge = `<span class="badge admitted">入場済</span>`;
        actionBtns = `<span style="color:#94a3b8;font-size:0.8rem;">完了</span>`;
      }

      return `
        <tr>
          <td><strong>No.${t.ticket_number}</strong></td>
          <td>${countBadge}</td>
          <td>${time}</td>
          <td>${badge}</td>
          <td>${actionBtns}</td>
        </tr>
      `;
    }).join("");
  }

  window.updateStatus = async function(ticketNumber, status, count = 1) {
    const actionName = status === "CALLED" ? `お呼び出し（${count}名様）` : "入場完了";
    if (!confirm(`No.${ticketNumber} を「${actionName}」にしますか？`)) return;

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/update-status`, {
        method: "POST",
        headers: { 
          "Content-Type": "application/json",
          "X-Admin-Key": getStaffKey(),
          "X-Admin-User": getStaffId()
        }
        ,
        body: JSON.stringify({ ticketNumber, status })
      });

      if (res.status === 401) {
        alert("認証が無効です。再度ログインしてください。");
        sessionStorage.removeItem("staff_key");
        sessionStorage.removeItem("staff_id");
        location.reload();
        return;
      }

      const data = await res.json();
      if (res.status === 403) {
        alert(data.message || "現在メンテナンス中のため操作できません。");
        return;
      }

      if (data.success) {
        loadData();
      } else {
        alert("更新に失敗しました: " + (data.message || ""));
      }
    } catch (e) {
      alert("通信エラーが発生しました");
    }
  };

  refreshBtn.addEventListener("click", loadData);

  setInterval(() => {
    if (getStaffKey()) loadData();
  }, 10000);

  window.addEventListener("load", loadData);
</script>

<style>
  /* 認証オーバーレイ */
  .auth-box { position: fixed; inset: 0; background: #0f172a; display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 16px; }
  .auth-card { background: white; border-radius: 16px; padding: 32px 24px; max-width: 360px; width: 100%; text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
  .lock-icon { font-size: 2.5rem; margin-bottom: 12px; }
  .auth-card h2 { margin: 0 0 8px; font-size: 1.25rem; color: #0f172a; }
  .auth-desc { font-size: 0.8rem; color: #64748b; margin-bottom: 20px; }
  .auth-card input { width: 100%; padding: 12px; font-size: 1rem; border: 2px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; margin-bottom: 12px; }
  .auth-card input:focus { outline: none; border-color: #0284c7; }
  .btn-unlock { width: 100%; padding: 12px; background: #0284c7; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; margin-top: 4px; }
  .btn-unlock:hover { background: #0369a1; }
  .auth-error { color: #ef4444; font-size: 0.8rem; margin-top: 10px; font-weight: bold; }

  /* ダッシュボード本体 */
  .admin-container { max-width: 800px; margin: 0 auto; padding: 20px 16px 80px; font-family: system-ui, -apple-system, sans-serif; }
  .admin-header { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
  .header-top { display: flex; align-items: center; justify-content: space-between; }
  .admin-header .tag { font-size: 0.7rem; font-weight: 900; background: #fee2e2; color: #dc2626; width: fit-content; padding: 2px 8px; border-radius: 4px; }
  .user-badge { font-size: 0.75rem; font-family: monospace; font-weight: 700; color: #475569; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; border: 1px solid #e2e8f0; }
  .admin-header h1 { font-size: 1.3rem; margin: 0; color: #0f172a; }
  .header-actions { display: flex; gap: 10px; }
  .btn-refresh { background: #f1f5f9; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; }
  .btn-lock { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; padding: 6px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; }

  /* 統計カード */
  .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 24px; }
  @media(min-width: 600px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
  .stat-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; text-align: center; }
  .stat-label { font-size: 0.75rem; color: #64748b; font-weight: bold; display: block; margin-bottom: 4px; }
  .stat-val { font-size: 1.8rem; font-weight: 900; color: #0f172a; }
  .stat-val-group { display: flex; align-items: baseline; justify-content: center; gap: 4px; }
  .stat-sub-val { font-size: 0.9rem; color: #0284c7; font-weight: 700; }
  .highlight-waiting .stat-val { color: #0284c7; }
  .highlight-called .stat-val { color: #d97706; }

  /* クイック呼出 */
  .quick-call-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: 16px; margin-bottom: 24px; }
  .quick-call-box h3 { margin: 0 0 10px 0; font-size: 0.95rem; color: #1e3a8a; }
  .quick-action { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .quick-headcount { background: #dbeafe; color: #1d4ed8; padding: 2px 6px; border-radius: 4px; font-weight: 800; }
  .btn-call-primary { background: #0284c7; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: bold; cursor: pointer; }
  .btn-call-primary:disabled { background: #94a3b8; cursor: not-allowed; }

  /* テーブル */
  .table-container { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; overflow-x: auto; }
  .table-container h2 { font-size: 1.05rem; margin: 0 0 14px 0; }
  .ticket-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
  .ticket-table th { padding: 10px 8px; border-bottom: 2px solid #e2e8f0; color: #64748b; font-size: 0.8rem; }
  .ticket-table td { padding: 12px 8px; border-bottom: 1px solid #f1f5f9; }

  .badge { padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; }
  .badge.waiting { background: #e0f2fe; color: #0369a1; }
  .badge.called { background: #fef3c7; color: #b45309; }
  .badge.admitted { background: #f1f5f9; color: #64748b; }
  .headcount-badge { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }

  .btn-sm { border: none; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; cursor: pointer; }
  .btn-call { background: #f59e0b; color: white; }
  .btn-admit { background: #10b981; color: white; }
</style>
