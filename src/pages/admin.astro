---
import Layout from '../layouts/Layout.astro';
---

<Layout title="スタッフ管理画面 | 整理券システム">
  <!-- 🔒 認証画面（GASメール認証コード入力） -->
  <div id="auth-overlay" class="auth-box">
    <div class="auth-card">
      <div class="lock-icon">📧</div>
      <h2>スタッフ認証</h2>
      <p class="auth-desc">登録されたメールアドレスに認証コードを送信します</p>
      
      <!-- ステップ1: メールアドレス入力 -->
      <div id="auth-step-email">
        <input 
          type="email" 
          id="email-input" 
          placeholder="登録済みメールアドレス" 
          autocomplete="email" 
        />
        <button id="btn-send-code" class="btn-unlock">認証コードを送信</button>
      </div>

      <!-- ステップ2: 認証コード入力 -->
      <div id="auth-step-code" style="display: none;">
        <p class="code-sent-note">メールに送信された6桁の認証コードを入力してください</p>
        <input 
          type="text" 
          id="code-input" 
          placeholder="6桁の認証コード (例: 123456)" 
          maxlength="6"
          inputmode="numeric"
          autocomplete="one-time-code" 
        />
        <button id="btn-verify-code" class="btn-unlock">ログイン</button>
        <button id="btn-back-email" class="btn-text">← メールアドレスを再入力</button>
      </div>

      <p id="auth-error" class="auth-error" style="display: none;"></p>
    </div>
  </div>

  <!-- 📊 管理ダッシュボード本体（認証成功時に表示） -->
  <div id="admin-main" class="admin-container" style="display: none;">
    <header class="admin-header">
      <div class="header-top">
        <div class="tag">STAFF ONLY</div>
        <span id="current-user-badge" class="user-badge">--</span>
      </div>
      <h1>プログラミング体験会 整理券運行パネル</h1>
      <div class="header-actions">
        <button id="btn-refresh" class="btn-refresh">🔄 データ更新</button>
        <button id="btn-lock" class="btn-lock">ログアウト</button>
      </div>
    </header>

    <!-- 📷 カメラ ＆ 🔌 バーコードスキャナー セクション -->
    <div class="scanner-card">
      <div class="scanner-header">
        <div class="scanner-title-group">
          <h3>📷 照合スキャナー</h3>
          <span class="barcode-status-tag">🔌 外付けスキャナー受付中</span>
        </div>
        <button id="btn-toggle-scanner" class="btn-scanner-toggle">カメラを起動</button>
      </div>
      
      <!-- カメラ映像表示領域 -->
      <div id="scanner-wrapper" style="display: none;">
        <div id="qr-reader"></div>
        <p class="scanner-hint">カメラにQR/バーコードをかざしてください</p>
      </div>

      <!-- スキャン照合結果メッセージ -->
      <div id="scan-result-box" class="scan-result-box" style="display: none;"></div>
    </div>

    <!-- 📊 統計カード -->
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-label">総発券組数</span>
        <span id="stat-total" class="stat-val">0</span>
      </div>
      <div class="stat-card highlight-waiting">
        <span class="stat-label">待機組数 (総人数)</span>
        <div class="stat-val-group">
          <span id="stat-waiting" class="stat-val">0</span>
          <span class="stat-sub-val">(<strong id="stat-waiting-people">0</strong>名)</span>
        </div>
      </div>
      <div class="stat-card highlight-called">
        <span class="stat-label">呼出中 (案内待ち)</span>
        <span id="stat-called" class="stat-val">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">案内完了</span>
        <span id="stat-admitted" class="stat-val">0</span>
      </div>
    </div>

    <!-- ⚡ クイック呼出バー -->
    <div class="quick-call-box">
      <h3>🚀 先頭の番号を呼出</h3>
      <div class="quick-action">
        <p id="next-calling-info">次の待機者: 読み込み中...</p>
        <button id="btn-call-next" class="btn-call-primary" disabled>次の組を呼出</button>
      </div>
    </div>

    <!-- 📋 整理券一覧テーブル -->
    <div class="table-container">
      <h2>整理券一覧</h2>
      <table class="ticket-table">
        <thead>
          <tr>
            <th>番号</th>
            <th>区分 / 名義</th>
            <th>人数</th>
            <th>発行時刻</th>
            <th>状態</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="ticket-list-body">
          <tr><td colspan="6" style="text-align:center;">読み込み中...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<script>
  import { Html5Qrcode } from 'html5-qrcode';

  const BACKEND_ENDPOINT = "https://ticket-api.zinn1019t.workers.dev";

  const authOverlay = document.getElementById("auth-overlay");
  const adminMain = document.getElementById("admin-main");
  const stepEmail = document.getElementById("auth-step-email");
  const stepCode = document.getElementById("auth-step-code");
  const emailInput = document.getElementById("email-input") as HTMLInputElement | null;
  const codeInput = document.getElementById("code-input") as HTMLInputElement | null;
  const sendCodeBtn = document.getElementById("btn-send-code") as HTMLButtonElement | null;
  const verifyCodeBtn = document.getElementById("btn-verify-code") as HTMLButtonElement | null;
  const backEmailBtn = document.getElementById("btn-back-email");
  const authError = document.getElementById("auth-error");
  const lockBtn = document.getElementById("btn-lock");
  const currentUserBadge = document.getElementById("current-user-badge");

  const totalEl = document.getElementById("stat-total");
  const waitingEl = document.getElementById("stat-waiting");
  const waitingPeopleEl = document.getElementById("stat-waiting-people");
  const calledEl = document.getElementById("stat-called");
  const admittedEl = document.getElementById("stat-admitted");
  const listBody = document.getElementById("ticket-list-body");
  const nextInfoEl = document.getElementById("next-calling-info");
  const callNextBtn = document.getElementById("btn-call-next") as HTMLButtonElement | null;
  const refreshBtn = document.getElementById("btn-refresh");

  const toggleScannerBtn = document.getElementById("btn-toggle-scanner");
  const scannerWrapper = document.getElementById("scanner-wrapper");
  const scanResultBox = document.getElementById("scan-result-box");

  let html5QrCode: Html5Qrcode | null = null;
  let isScanning = false;
  let pollIntervalId: number | null = null;

  function showAuthError(msg: string) {
    if (authError) {
      authError.textContent = msg;
      authError.style.display = "block";
    }
  }

  function hideAuthError() {
    if (authError) {
      authError.style.display = "none";
    }
  }

  function startPolling() {
    if (!pollIntervalId) {
      pollIntervalId = window.setInterval(() => {
        if (getStaffKey()) loadData();
      }, 10000);
    }
  }

  function stopPolling() {
    if (pollIntervalId) {
      clearInterval(pollIntervalId);
      pollIntervalId = null;
    }
  }

  function getStaffKey() {
    return sessionStorage.getItem("staff_key") || "";
  }

  function getStaffEmail() {
    return sessionStorage.getItem("staff_email") || "";
  }

  function getStaffName() {
    return sessionStorage.getItem("staff_name") || "";
  }

  // --- Step 1: 認証コード送信 ---
  sendCodeBtn?.addEventListener("click", async () => {
    const email = emailInput?.value.trim().toLowerCase() || "";
    if (!email || !email.includes("@")) {
      showAuthError("有効なメールアドレスを入力してください");
      return;
    }

    sendCodeBtn.disabled = true;
    sendCodeBtn.textContent = "送信中...";
    hideAuthError();

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/send-auth-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        if (stepEmail) stepEmail.style.display = "none";
        if (stepCode) stepCode.style.display = "block";
        if (codeInput) {
          codeInput.value = "";
          codeInput.focus();
        }
      } else {
        showAuthError(data.message || "認証メールの送信に失敗しました");
      }
    } catch (e) {
      showAuthError("通信エラーが発生しました");
    } finally {
      sendCodeBtn.disabled = false;
      sendCodeBtn.textContent = "認証コードを送信";
    }
  });

  // --- Step 2: 認証コード検証 ---
  verifyCodeBtn?.addEventListener("click", async () => {
    const email = emailInput?.value.trim().toLowerCase() || "";
    const code = codeInput?.value.trim() || "";

    if (!code || code.length !== 6) {
      showAuthError("6桁の認証コードを入力してください");
      return;
    }

    verifyCodeBtn.disabled = true;
    verifyCodeBtn.textContent = "検証中...";
    hideAuthError();

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/verify-auth-code`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, code })
      });
      const data = await res.json();

      if (res.ok && data.success) {
        sessionStorage.setItem("staff_email", data.email);
        sessionStorage.setItem("staff_key", data.adminKey);
        sessionStorage.setItem("staff_name", data.name);
        loadData();
      } else {
        showAuthError(data.message || "認証コードが正しくありません");
      }
    } catch (e) {
      showAuthError("認証サーバーへの接続に失敗しました");
    } finally {
      verifyCodeBtn.disabled = false;
      verifyCodeBtn.textContent = "ログイン";
    }
  });

  backEmailBtn?.addEventListener("click", () => {
    if (stepCode) stepCode.style.display = "none";
    if (stepEmail) stepEmail.style.display = "block";
    hideAuthError();
  });

  emailInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") sendCodeBtn?.click();
  });

  codeInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") verifyCodeBtn?.click();
  });

  lockBtn?.addEventListener("click", () => {
    stopPolling();
    stopScanner();
    sessionStorage.clear();
    location.reload();
  });

  // --- 🔌 外付けバーコードスキャナー入力検知 ---
  let barcodeBuffer = "";
  let lastKeyTime = 0;

  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    if (authOverlay && authOverlay.style.display !== "none") return;
    if (target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA")) return;

    const currentTime = Date.now();
    if (currentTime - lastKeyTime > 100) {
      barcodeBuffer = "";
    }
    lastKeyTime = currentTime;

    if (e.key === "Enter") {
      if (barcodeBuffer.length > 0) {
        handleScannedCode(barcodeBuffer);
        barcodeBuffer = "";
      }
    } else if (e.key.length === 1) {
      barcodeBuffer += e.key;
    }
  });

  // --- 📷 Webカメラ表示切り替え ---
  toggleScannerBtn?.addEventListener("click", () => {
    if (isScanning) {
      stopScanner();
    } else {
      startScanner();
    }
  });

  async function startScanner() {
    if (scannerWrapper) scannerWrapper.style.display = "block";
    if (toggleScannerBtn) {
      toggleScannerBtn.textContent = "カメラを停止";
      toggleScannerBtn.classList.add("btn-active");
    }
    if (scanResultBox) scanResultBox.style.display = "none";

    html5QrCode = new Html5Qrcode("qr-reader");

    try {
      await html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 220, height: 220 } },
        (decodedText) => handleScannedCode(decodedText),
        () => {}
      );
      isScanning = true;
    } catch (err) {
      console.error("Camera access error:", err);
      alert("カメラの起動に失敗しました。アクセス許可を確認してください。");
      stopScanner();
    }
  }

  async function stopScanner() {
    if (html5QrCode && isScanning) {
      try {
        await html5QrCode.stop();
      } catch (e) {}
    }
    isScanning = false;
    if (scannerWrapper) scannerWrapper.style.display = "none";
    if (toggleScannerBtn) {
      toggleScannerBtn.textContent = "カメラを起動";
      toggleScannerBtn.classList.remove("btn-active");
    }
  }

  let lastScannedText = "";
  let lastScanTime = 0;

  // 統合照合処理（カメラ / 外付けバーコードリーダー共通）
  async function handleScannedCode(rawCode: string) {
    const now = Date.now();
    if (rawCode === lastScannedText && now - lastScanTime < 3000) {
      return;
    }
    lastScannedText = rawCode;
    lastScanTime = now;

    let ticketNumber: string | null = null;
    const text = rawCode.trim();

    if (text.startsWith("SHOKO:") || text.startsWith("SHOKO-TICKET:")) {
      const parts = text.split(":");
      ticketNumber = parts[1]?.replace("No.", "").trim() || null;
    } else if (!isNaN(Number(text.replace("No.", "")))) {
      ticketNumber = text.replace("No.", "").trim();
    }

    if (!ticketNumber) {
      showScanResult("⚠️ 無効なコード形式です: " + text, "error");
      return;
    }

    showScanResult(`🔍 No.${ticketNumber} を照合中...`, "info");
    
    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/update-status`, {
        method: "POST",
        headers: { 
          "Content-Type": "application/json",
          "X-Admin-Key": getStaffKey(),
          "X-Admin-User": getStaffEmail()
        },
        body: JSON.stringify({ ticketNumber: Number(ticketNumber), status: "ADMITTED" })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showScanResult(`✅ No.${ticketNumber} の入場処理が完了しました！`, "success");
        loadData();
      } else {
        showScanResult(`❌ 照合失敗: ${data.message || "未登録の整理券です"}`, "error");
      }
    } catch (e) {
      showScanResult("⚠️ 通信エラーが発生しました", "error");
    }
  }

  function showScanResult(msg: string, type: "info" | "success" | "error") {
    if (scanResultBox) {
      scanResultBox.textContent = msg;
      scanResultBox.className = `scan-result-box scan-${type}`;
      scanResultBox.style.display = "block";
    }
  }

  // --- 一覧データ取得 ---
  async function loadData() {
    const staffKey = getStaffKey();
    const staffEmail = getStaffEmail();

    if (!staffKey || !staffEmail) {
      stopPolling();
      if (authOverlay) authOverlay.style.display = "flex";
      if (adminMain) adminMain.style.display = "none";
      return;
    }

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/list`, {
        headers: { 
          "X-Admin-Key": staffKey,
          "X-Admin-User": staffEmail
        }
      });

      if (res.status === 401) {
        stopPolling();
        sessionStorage.clear();
        if (authOverlay) authOverlay.style.display = "flex";
        if (adminMain) adminMain.style.display = "none";
        showAuthError("認証セッションが切れました。再度ログインしてください。");
        return;
      }

      if (res.status === 403) {
        stopPolling();
        const errData = await res.json().catch(() => ({}));
        if (authOverlay) authOverlay.style.display = "none";
        if (adminMain) adminMain.style.display = "block";
        if (currentUserBadge) {
          currentUserBadge.textContent = `LOGIN: ${getStaffName() || staffEmail}`;
        }
        if (listBody) {
          listBody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:30px;color:#dc2626;font-weight:bold;">⚠️ ${errData.message || "現在管理画面はメンテナンス停止中です"}</td></tr>`;
        }
        if (nextInfoEl) nextInfoEl.textContent = "システム停止中";
        if (callNextBtn) callNextBtn.disabled = true;
        return;
      }

      const data = await res.json();
      if (!data.success) throw new Error(data.message);

      startPolling();

      if (authOverlay) authOverlay.style.display = "none";
      if (adminMain) adminMain.style.display = "block";
      hideAuthError();

      if (currentUserBadge) {
        currentUserBadge.textContent = `STAFF: ${getStaffName() || staffEmail}`;
      }

      if (totalEl) totalEl.textContent = data.stats.total;
      if (waitingEl) waitingEl.textContent = data.stats.waiting;
      if (calledEl) calledEl.textContent = data.stats.called;
      if (admittedEl) admittedEl.textContent = data.stats.admitted;

      const waitingHeadcount = (data.tickets || [])
        .filter((t: any) => t.status === "WAITING")
        .reduce((sum: number, t: any) => sum + (Number(t.headcount) || 1), 0);
      if (waitingPeopleEl) {
        waitingPeopleEl.textContent = String(waitingHeadcount);
      }

      renderTable(data.tickets);
      updateQuickCall(data.tickets);
    } catch (e) {
      console.error(e);
      if (listBody) {
        listBody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:#ef4444;">データの取得に失敗しました</td></tr>`;
      }
    }
  }

  function updateQuickCall(tickets: any[]) {
    const nextWaiting = (tickets || []).slice().reverse().find(t => t.status === "WAITING") || tickets.find(t => t.status === "WAITING");
    
    if (nextWaiting && nextInfoEl && callNextBtn) {
      const count = nextWaiting.headcount || 1;
      const typeStr = nextWaiting.visitor_type === "family" ? "ご家族連れ" : "一般";
      nextInfoEl.innerHTML = `次は <strong>No.${nextWaiting.ticket_number}</strong>（<span class="quick-headcount">${typeStr} / ${count}名</span>）です`;
      callNextBtn.disabled = false;
      callNextBtn.onclick = () => (window as any).updateStatus(nextWaiting.ticket_number, "CALLED", count);
    } else if (nextInfoEl && callNextBtn) {
      nextInfoEl.textContent = "待機中の来場者はいません";
      callNextBtn.disabled = true;
    }
  }

  function renderTable(tickets: any[]) {
    if (!listBody) return;
    if (!tickets || tickets.length === 0) {
      listBody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:#94a3b8;">発券されたチケットはありません</td></tr>`;
      return;
    }

    listBody.innerHTML = tickets.map(t => {
      let time = "--:--";
      if (t.created_at) {
        const utcIsoString = t.created_at.includes("T") ? t.created_at : t.created_at.replace(" ", "T") + "Z";
        time = new Date(utcIsoString).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
      }
      
      const typeLabel = t.visitor_type === "family" ? "👨‍👩‍👧‍👦 家族" : "👤 一般";
      const nameStr = t.parent_name ? escapeHtml(t.parent_name) : "-";
      const countBadge = `<span class="badge headcount-badge">${t.headcount || 1}名</span>`;

      let badge = `<span class="badge waiting">待機中</span>`;
      let actionBtns = `
        <button class="btn-sm btn-call" onclick="updateStatus(${t.ticket_number}, 'CALLED', ${t.headcount || 1})">呼出</button>
      `;

      if (t.status === "CALLED") {
        badge = `<span class="badge called">呼出中</span>`;
        actionBtns = `
          <button class="btn-sm btn-admit" onclick="updateStatus(${t.ticket_number}, 'ADMITTED', ${t.headcount || 1})">入場完了</button>
        `;
      } else if (t.status === "ADMITTED") {
        badge = `<span class="badge admitted">入場済</span>`;
        actionBtns = `<span style="color:#94a3b8;font-size:0.8rem;">完了</span>`;
      }

      return `
        <tr>
          <td><strong>No.${t.ticket_number}</strong></td>
          <td><span class="type-tag">${typeLabel}</span> <br><small class="name-sub">${nameStr}</small></td>
          <td>${countBadge}</td>
          <td>${time}</td>
          <td>${badge}</td>
          <td>${actionBtns}</td>
        </tr>
      `;
    }).join("");
  }

  function escapeHtml(str: string) {
    return String(str).replace(/[&<>"']/g, (m) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m] || m));
  }

  (window as any).updateStatus = async function(ticketNumber: number, status: string, count = 1) {
    const actionName = status === "CALLED" ? `お呼び出し（${count}名様）` : "入場完了";
    if (!confirm(`No.${ticketNumber} を「${actionName}」にしますか？`)) return;

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/admin/update-status`, {
        method: "POST",
        headers: { 
          "Content-Type": "application/json",
          "X-Admin-Key": getStaffKey(),
          "X-Admin-User": getStaffEmail()
        },
        body: JSON.stringify({ ticketNumber, status })
      });

      if (res.status === 401) {
        alert("認証が無効です。再度ログインしてください。");
        sessionStorage.clear();
        location.reload();
        return;
      }

      const data = await res.json();
      if (res.status === 403) {
        alert(data.message || "現在メンテナンス中のため操作できません。");
        return;
      }

      if (data.success) {
        loadData();
      } else {
        alert("更新に失敗しました: " + (data.message || ""));
      }
    } catch (e) {
      alert("通信エラーが発生しました");
    }
  };

  refreshBtn?.addEventListener("click", () => {
    loadData();
  });

  window.addEventListener("load", loadData);
</script>

<style>
  /* 認証オーバーレイ */
  .auth-box { position: fixed; inset: 0; background: #0f172a; display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 16px; }
  .auth-card { background: white; border-radius: 16px; padding: 32px 24px; max-width: 380px; width: 100%; text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
  .lock-icon { font-size: 2.5rem; margin-bottom: 12px; }
  .auth-card h2 { margin: 0 0 8px; font-size: 1.25rem; color: #0f172a; }
  .auth-desc { font-size: 0.8rem; color: #64748b; margin-bottom: 20px; line-height: 1.4; }
  .code-sent-note { font-size: 0.8rem; color: #2563eb; margin-bottom: 14px; font-weight: bold; }
  .auth-card input { width: 100%; padding: 12px; font-size: 1rem; border: 2px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; margin-bottom: 12px; }
  .auth-card input:focus { outline: none; border-color: #0284c7; }
  .btn-unlock { width: 100%; padding: 12px; background: #0284c7; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; margin-top: 4px; }
  .btn-unlock:hover { background: #0369a1; }
  .btn-text { background: none; border: none; color: #64748b; font-size: 0.8rem; margin-top: 12px; cursor: pointer; text-decoration: underline; }
