---
import Layout from '../layouts/Layout.astro';
---

<Layout title="整理券発行 | 第7回商工祭">
  <div class="cyber-portal">
    <div class="digital-bg"></div>
    <div class="neon-glow"></div>

    <header class="cyber-header">
      <div class="header-line"></div>
      <h1>整理券発行システム <span class="ver">v2.0</span></h1>
      <p class="cyber-subtitle">SMART TICKETING // NO PERSONAL DATA</p>
    </header>

    <main class="portal-container">
      <!-- 💎 サイバークリスタル演出（index.astroと統一） -->
      <div class="crystal c-1"><div class="crystal-core"></div></div>
      <div class="crystal c-2"><div class="crystal-core shadow-core"></div></div>
      <div class="crystal c-3"><div class="crystal-core"></div></div>
      <div class="crystal c-4"><div class="crystal-core shadow-core"></div></div>

      <div class="ticket-card">
        <div class="tile-edge"></div>

        <!-- ① 初期読み込み中表示 -->
        <div id="status-loading" class="panel-section">
          <div class="cyber-scanner">
            <div class="scan-beam"></div>
          </div>
          <p class="scanning-text">LINE AUTHENTICATING...</p>
        </div>

        <!-- ② 未発券状態（発券ボタン） -->
        <div id="status-unissued" class="panel-section" style="display: none;">
          <div class="status-badge" id="mode-badge">TICKET SYSTEM</div>
          <h2 class="card-headline">アトラクション整理券</h2>
          
          <div class="guide-box">
            <div class="guide-item">
              <span class="guide-bullet">🛡️</span>
              <p>氏名・電話番号・メールアドレス等の<strong>個人情報は一切取得しません</strong>。</p>
            </div>
            <div class="guide-item">
              <span class="guide-bullet">💬</span>
              <p>公式LINEが自動連携され、順番が近づくと<strong>LINE通知でお知らせ</strong>します。</p>
            </div>
            <div class="guide-item">
              <span class="guide-bullet">🚶</span>
              <p>整理券取得後は、お呼び出しまで校内をご自由にお回りいただけます。</p>
            </div>
          </div>

          <button id="btn-issue" class="cyber-issue-btn">
            <span class="btn-icon">🎟️</span>
            <span class="btn-title">LINEで整理券を取得</span>
          </button>
        </div>

        <!-- ③ 発券完了状態（番号 ＆ リアルタイム認証時計） -->
        <div id="status-issued" class="panel-section" style="display: none;">
          <div class="status-badge live-badge">
            <span class="pulse-dot"></span> TICKET VERIFIED
          </div>

          <p class="ticket-sublabel">あなたの整理券番号</p>
          <div class="number-wrapper">
            <span class="num-prefix">No.</span>
            <span id="ticket-number" class="ticket-num">--</span>
          </div>

          <!-- スクショ使い回し防止：常時動くミリ秒付きデジタル時計 -->
          <div class="live-clock-card">
            <span class="clock-label">CURRENT TIME // 照合用</span>
            <div id="live-clock" class="clock-display">--:--:--.--</div>
          </div>

          <div class="flow-message">
            <p>※順番が近づきましたら公式LINEに通知が届きます。受付にてこの画面をご提示ください。</p>
          </div>
        </div>

        <!-- エラー表示 -->
        <div id="status-error" class="panel-section" style="display: none;">
          <div class="status-badge error-badge">ERROR</div>
          <p id="error-message" class="error-text">通信エラーが発生しました。</p>
          <button class="cyber-retry-btn" onclick="location.reload()">再読み込み</button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<!-- LIFF SDK -->
<script is:inline src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

<script is:inline>
  const LIFF_ID = "YOUR_LIFF_ID"; // LINE DevelopersのLIFF ID
  const BACKEND_ENDPOINT = "https://ticket-api.xxxx.workers.dev"; // WorkersのURL

  // 🛠️ 学校端末やローカルテスト用のバイパス判定（localhost、127.0.0.1、またはURLに ?dev=true）
  const isDevMode = 
    window.location.hostname === "localhost" || 
    window.location.hostname === "127.0.0.1" || 
    new URLSearchParams(window.location.search).has("dev");

  const loadingEl = document.getElementById("status-loading");
  const unissuedEl = document.getElementById("status-unissued");
  const issuedEl = document.getElementById("status-issued");
  const errorEl = document.getElementById("status-error");
  const errorMsgEl = document.getElementById("error-message");
  const numberEl = document.getElementById("ticket-number");
  const issueBtn = document.getElementById("btn-issue");
  const clockEl = document.getElementById("live-clock");
  const modeBadgeEl = document.getElementById("mode-badge");

  function startClock() {
    function update() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      const ms = String(Math.floor(now.getMilliseconds() / 100));
      if (clockEl) {
        clockEl.textContent = `${h}:${m}:${s}.${ms}`;
      }
      requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  function displayTicket(ticketNo) {
    numberEl.innerText = ticketNo;
    loadingEl.style.display = "none";
    unissuedEl.style.display = "none";
    errorEl.style.display = "none";
    issuedEl.style.display = "block";
    startClock();
  }

  function displayError(msg) {
    loadingEl.style.display = "none";
    unissuedEl.style.display = "none";
    issuedEl.style.display = "none";
    errorMsgEl.innerText = msg;
    errorEl.style.display = "block";
  }

  async function init() {
    // 既に発券済みの整理券がある場合は即時表示
    const cachedNo = localStorage.getItem("shokosai_ticket_no");
    if (cachedNo) {
      displayTicket(cachedNo);
      return;
    }

    // 🧪 開発・学校内テストモード（LIFF認証をバイパス）
    if (isDevMode) {
      console.warn("⚠️ [DEV MODE] 学校環境またはテスト実行のため、LIFF初期化をスキップします。");
      if (modeBadgeEl) {
        modeBadgeEl.textContent = "DEV TEST MODE";
        modeBadgeEl.style.background = "#fef3c7";
        modeBadgeEl.style.color = "#b45309";
      }
      loadingEl.style.display = "none";
      unissuedEl.style.display = "block";
      return;
    }

    // 🚀 本番モード（LIFFログイン実行）
    try {
      await liff.init({ liffId: LIFF_ID });

      if (!liff.isLoggedIn()) {
        liff.login();
        return;
      }

      loadingEl.style.display = "none";
      unissuedEl.style.display = "block";

    } catch (err) {
      console.error("LIFF Init Error:", err);
      displayError("LINE認証の初期化に失敗しました。電波の良い環境で再度アクセスしてください。");
    }
  }

  issueBtn?.addEventListener("click", async () => {
    issueBtn.disabled = true;
    issueBtn.querySelector(".btn-title").innerText = "発券処理中...";

    try {
      let payload = {};

      if (isDevMode) {
        // テスト用：端末ごとにダミーUIDを生成・保持
        let mockUid = localStorage.getItem("mock_shoko_uid");
        if (!mockUid) {
          mockUid = "U_mock_" + Math.random().toString(36).substring(2, 10);
          localStorage.setItem("mock_shoko_uid", mockUid);
        }
        payload = { mockUserId: mockUid };
      } else {
        // 本番：正規の暗号化IDトークン（JWT）
        const idToken = liff.getIDToken();
        payload = { idToken };
      }

      const res = await fetch(BACKEND_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (data.success) {
        localStorage.setItem("shokosai_ticket_no", data.ticketNumber);
        displayTicket(data.ticketNumber);
      } else {
        alert(data.message || "発券に失敗しました。");
        issueBtn.disabled = false;
        issueBtn.querySelector(".btn-title").innerText = "LINEで整理券を取得";
      }
    } catch (err) {
      console.error("Issue Error:", err);
      alert("通信エラーが発生しました。");
      issueBtn.disabled = false;
      issueBtn.querySelector(".btn-title").innerText = "LINEで整理券を取得";
    }
  });

  window.addEventListener("load", init);
</script>

<style>
  .cyber-portal {
    position: relative;
    min-height: 100vh;
    padding: 20px 16px 100px;
  }

  .digital-bg {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: 
      linear-gradient(rgba(15, 23, 42, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: -2;
  }

  .neon-glow {
    position: fixed;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: radial-gradient(circle at center, rgba(6, 199, 85, 0.05) 0%, transparent 60%);
    z-index: -1;
  }

  .cyber-header { text-align: center; margin-bottom: 30px; padding-top: 20px; }
  .header-line { width: 40px; height: 4px; background: #06c755; margin: 0 auto 15px; box-shadow: 0 2px 8px rgba(6, 199, 85, 0.3); }
  .cyber-header h1 { font-size: 1.4rem; font-weight: 900; margin: 0; letter-spacing: 0.05em; color: #1e3a8a; }
  .ver { font-size: 0.8rem; vertical-align: top; color: #06c755; }
  .cyber-subtitle { font-size: 0.75rem; color: #64748b; opacity: 0.8; letter-spacing: 0.15em; margin-top: 5px; font-weight: 600; }

  .portal-container {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
  }

  .crystal { position: absolute; z-index: 1; pointer-events: none; }
  .c-1 { top: -20px; left: -25px; width: 30px; height: 50px; animation: float1 4s infinite ease-in-out; }
  .c-2 { top: 120px; right: -30px; width: 22px; height: 38px; opacity: 0.7; animation: float2 5s infinite ease-in-out; }
  .c-3 { bottom: 80px; left: -30px; width: 24px; height: 42px; opacity: 0.75; animation: float3 4.5s infinite ease-in-out; }
  .c-4 { bottom: -10px; right: -25px; width: 28px; height: 48px; animation: float4 4.2s infinite ease-in-out; }

  .crystal-core {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(6, 199, 85, 0.6) 0%, rgba(0, 180, 216, 0.5) 100%);
    clip-path: polygon(50% 0%, 100% 35%, 100% 65%, 50% 100%, 0% 65%, 0% 35%);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .shadow-core {
    background: linear-gradient(135deg, rgba(0, 180, 216, 0.5) 0%, rgba(114, 9, 183, 0.45) 100%);
  }

  @keyframes float1 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes float2 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }
  @keyframes float3 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes float4 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(7px); } }

  .ticket-card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: 36px 24px 28px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    z-index: 2;
    text-align: center;
    box-sizing: border-box;
  }

  .tile-edge {
    position: absolute;
    top: 0; left: 0; width: 14px; height: 14px;
    border-top: 3px solid #06c755;
    border-left: 3px solid #06c755;
    border-top-left-radius: 4px;
  }

  .card-headline {
    margin: 8px 0 16px;
    font-size: 1.25rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
    margin-bottom: 8px;
  }
  .live-badge { background: rgba(6, 199, 85, 0.1); color: #059669; }
  .error-badge { background: rgba(239, 68, 68, 0.1); color: #dc2626; }

  .guide-box {
    text-align: left;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px 14px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .guide-item { display: flex; align-items: flex-start; gap: 8px; font-size: 0.83rem; line-height: 1.45; color: #475569; }
  .guide-item p { margin: 0; }
  .guide-item strong { color: #0f172a; }
  .guide-bullet { font-size: 0.95rem; line-height: 1.2; }

  .cyber-issue-btn {
    width: 100%;
    padding: 16px 20px;
    background: linear-gradient(135deg, #06c755 0%, #05a746 100%);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(6, 199, 85, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cyber-issue-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(6, 199, 85, 0.45); }
  .cyber-issue-btn:active { transform: translateY(1px); }
  .cyber-issue-btn:disabled { background: #94a3b8; cursor: not-allowed; transform: none; box-shadow: none; }

  .ticket-sublabel { font-size: 0.85rem; font-weight: 700; color: #64748b; margin: 12px 0 0; }
  .number-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    margin: 8px 0 16px;
  }
  .num-prefix { font-size: 1.6rem; font-weight: 800; color: #64748b; }
  .ticket-num {
    font-size: 4.4rem;
    font-weight: 900;
    color: #06c755;
    letter-spacing: -0.03em;
    line-height: 1;
    font-family: monospace, system-ui;
  }

  .live-clock-card {
    background: #0a0e17;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 16px;
  }
  .clock-label { font-size: 0.65rem; color: #64748b; font-family: monospace; display: block; margin-bottom: 2px; }
  .clock-display { font-size: 1.25rem; font-family: monospace; font-weight: 700; color: #00f2ff; letter-spacing: 0.08em; }

  .flow-message p { font-size: 0.78rem; color: #64748b; line-height: 1.45; margin: 0; }

  .cyber-scanner {
    width: 60px; height: 60px;
    margin: 20px auto 16px;
    border: 2px solid rgba(6, 199, 85, 0.2);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }
  .scan-beam {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 4px;
    background: #06c755;
    box-shadow: 0 0 10px #06c755;
    animation: scanAnim 1.6s infinite ease-in-out;
  }
  @keyframes scanAnim { 0% { top: 0%; } 50% { top: 92%; } 100% { top: 0%; } }
  .scanning-text { font-family: monospace; font-size: 0.8rem; color: #64748b; }

  .pulse-dot {
    width: 6px; height: 6px;
    background: #059669;
    border-radius: 50%;
    animation: pulse 1.4s infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .cyber-retry-btn {
    margin-top: 14px;
    padding: 8px 18px;
    background: #e2e8f0;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
  }
  .error-text { color: #dc2626; font-size: 0.85rem; }
</style>
