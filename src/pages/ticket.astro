---
import Layout from '../layouts/Layout.astro';

// イベント開催日（10/30, 10/31）
const EVENT_DATES = [
  { date: '2026-10-30', label: '10/30 (金)' },
  { date: '2026-10-31', label: '10/31 (土)' },
];

// 1日3回の時間枠定義
const TIME_SLOTS = [
  { id: 'slot_1', name: '第一回', time: '10:00〜11:00' },
  { id: 'slot_2', name: '第二回', time: '11:30〜12:30' },
  { id: 'slot_3', name: '第三回', time: '13:00〜14:00' },
];
---

<Layout title="プログラミング体験会 整理券予約 | 第7回商工祭">
  <div class="bright-code-portal">
    <div class="white-gradient-bg"></div>
    <div class="code-grid-pattern"></div>

    <div class="floating-shapes">
      <div class="shape crystal c-1"><div class="crystal-facet"></div></div>
      <div class="shape crystal c-2"><div class="crystal-facet alt"></div></div>
      <div class="shape cube shape-1"></div>
      <div class="shape circle shape-2"></div>
    </div>

    <header class="terminal-header">
      <div class="header-badge">&lt;PROGRAMMING_BOOTH /&gt;</div>
      <h1>日時指定 整理券予約</h1>
      <p class="terminal-subtitle">SMART SCHEDULE // 個人情報は一切不要</p>
    </header>

    <main class="portal-container">
      <div class="editor-window">
        <div class="window-titlebar">
          <div class="traffic-lights">
            <span class="dot dot-close"></span>
            <span class="dot dot-min"></span>
            <span class="dot dot-max"></span>
          </div>
          <span class="tab-title">calendar_reservation.ts</span>
          <span class="mode-tag" id="mode-badge">CONNECTING...</span>
        </div>

        <!-- ① 初期読み込み中 -->
        <div id="status-loading" class="editor-body">
          <div class="loader-terminal">
            <div class="cursor-line">&gt; system.connect()<span class="blink">_</span></div>
            <p id="loading-text" class="status-console">INITIALIZING ENVIRONMENT...</p>
          </div>
        </div>

        <!-- ② 予約入力フォーム -->
        <div id="status-unissued" class="editor-body" style="display: none;">
          <div class="notice-card">
            <div class="notice-item">
              <span class="icon">🛡️</span>
              <p>電話番号等の<strong>情報は一切取得しません</strong>。</p>
            </div>
            <div class="notice-item">
              <span class="icon">📅</span>
              <p>ご希望の<strong>日付と時間帯（第一回〜第三回）</strong>を選択してください。</p>
            </div>
          </div>

          <!-- STEP 1: 日付選択 -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">1</span>
              <label class="field-label">体験希望日の選択</label>
              <span class="code-tag">&lt;date /&gt;</span>
            </div>
            <div class="date-grid" id="date-selector">
              {EVENT_DATES.map((d, index) => (
                <button 
                  type="button" 
                  class={`btn-date ${index === 0 ? 'active' : ''}`} 
                  data-date={d.date}
                >
                  <span class="date-label">{d.label}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- STEP 2: 時間枠選択（残枠リアルタイム連動） -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">2</span>
              <label class="field-label">時間帯の選択 (1日3回)</label>
              <span class="code-tag">&lt;timeslot /&gt;</span>
            </div>
            <div class="slot-list" id="slot-selector">
              {TIME_SLOTS.map((s, index) => (
                <div 
                  class={`slot-card ${index === 0 ? 'active' : ''}`} 
                  data-slot-id={s.id}
                  data-slot-name={`${s.name} (${s.time})`}
                >
                  <div class="slot-info">
                    <span class="slot-title">{s.name}</span>
                    <span class="slot-time">{s.time}</span>
                  </div>
                  <div class="slot-status">
                    <span class="badge-status badge-ok" id={`badge-${s.id}`}>受付中 (残15/15枠)</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- STEP 3: お子様の人数 -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">3</span>
              <label class="field-label">体験するお子様の人数</label>
              <span class="code-tag">&lt;children /&gt;</span>
            </div>
            <div class="selector-grid" id="child-selector">
              <button type="button" class="btn-select active" data-count="1">1名</button>
              <button type="button" class="btn-select" data-count="2">2名</button>
              <button type="button" class="btn-select" data-count="3">3名</button>
              <button type="button" class="btn-select" data-count="4">4名〜</button>
            </div>
          </div>

          <!-- STEP 4: お子様のお名前入力欄（人数に合わせて動的変更） -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">4</span>
              <label class="field-label">体験するお子様のお名前 <span class="sub-label">（任意）</span></label>
              <span class="code-tag">&lt;names /&gt;</span>
            </div>
            <div id="child-names-container" class="names-container">
              <div class="name-input-wrapper">
                <span class="name-index">1人目</span>
                <input type="text" class="child-name-input code-input" placeholder="例: やまだ たろう" maxlength="30" />
              </div>
            </div>
          </div>

          <!-- 兄弟分割オプション -->
          <div id="split-wrapper" class="field-block split-option" style="display: none;">
            <label class="checkbox-container">
              <input type="checkbox" id="split-ticket-checkbox" />
              <span class="checkbox-custom"></span>
              <div class="checkbox-text-group">
                <span class="checkbox-title">兄弟で整理券番号を分ける</span>
                <span class="checkbox-desc">※席や時間を個別に分けたい場合</span>
              </div>
            </label>
          </div>

          <!-- STEP 5: 保護者の人数 -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">5</span>
              <label class="field-label">同伴する保護者の人数</label>
              <span class="code-tag">&lt;guardians /&gt;</span>
            </div>
            <div class="selector-grid" id="adult-selector">
              <button type="button" class="btn-select" data-count="0">0名</button>
              <button type="button" class="btn-select active" data-count="1">1名</button>
              <button type="button" class="btn-select" data-count="2">2名</button>
              <button type="button" class="btn-select" data-count="3">3名〜</button>
            </div>
          </div>

          <!-- STEP 6: 備考・ご要望 -->
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">6</span>
              <label class="field-label">備考・ご要望 <span class="sub-label">（任意）</span></label>
              <span class="code-tag">// optional</span>
            </div>
            <textarea
              id="ticket-note"
              class="code-textarea"
              placeholder="学年やPC経験、ご質問などがあれば入力してください"
              maxlength="150"
              rows="2"
            ></textarea>
          </div>

          <div id="turnstile-container" class="turnstile-container" style="display: none;"></div>

          <button id="btn-issue" class="terminal-btn" disabled>
            <span class="btn-arrow">&gt;&gt;</span>
            <span id="btn-title-text" class="btn-title">LINEで整理券を予約する</span>
          </button>
        </div>

        <!-- ③ 発券・予約完了状態 -->
        <div id="status-issued" class="editor-body" style="display: none;">
          <div class="terminal-success-badge">
            <span class="pulse-dot"></span> RESERVATION CONFIRMED
          </div>

          <p class="result-title">// 予約が完了しました</p>
          <div class="ticket-display">
            <div class="num-wrapper">
              <span id="ticket-number" class="ticket-num">--</span>
            </div>
          </div>

          <div class="ticket-meta-box">
            <div class="meta-row">
              <span class="meta-key">予約日時:</span>
              <span id="res-datetime" class="meta-val">--</span>
            </div>
            <div class="meta-row">
              <span class="meta-key">体験お子様:</span>
              <span id="res-child" class="meta-val">1名</span>
            </div>
            <div class="meta-row">
              <span class="meta-key">保護者同伴:</span>
              <span id="res-adult" class="meta-val">1名</span>
            </div>
            <div class="meta-row" id="res-names-row" style="display: none;">
              <span class="meta-key">お子様お名前:</span>
              <span id="res-child-names" class="meta-val">--</span>
            </div>
            <div class="meta-row" id="res-note-row" style="display: none;">
              <span class="meta-key">備考・ご要望:</span>
              <span id="res-note" class="meta-val">--</span>
            </div>
          </div>

          <div class="live-clock-card">
            <span class="clock-label">CURRENT TIME // 照合確認用</span>
            <div id="live-clock" class="clock-display">--:--:--.--</div>
          </div>

          <div class="console-footer">
            <p>※指定のお時間になりましたら、体験ブース受付にてこの画面をご提示ください。</p>
          </div>
        </div>

        <!-- ④ エラー表示 -->
        <div id="status-error" class="editor-body" style="display: none;">
          <div class="terminal-error-badge">EXCEPTION CAUGHT</div>
          <p id="error-message" class="error-text">通信エラーが発生しました。</p>
          <button class="terminal-btn retry-btn" onclick="location.reload()">
            &gt; SYSTEM.RETRY()
          </button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const LIFF_ID = "2011672035-MlQEQgzQ";
  const BACKEND_ENDPOINT = "https://ticket-api.zinn1019t.workers.dev";
  const TURNSTILE_SITE_KEY = "0x4AAAAAAE82keLXX6udcUpX";
  const MAX_SLOT_CAPACITY = 15; // 15枠に変更

  const urlParams = new URLSearchParams(window.location.search);
  const isDevMode = 
    urlParams.get("dev") === "true" || 
    window.location.hostname === "localhost" || 
    window.location.hostname === "127.0.0.1";

  const loadingEl = document.getElementById("status-loading");
  const loadingTextEl = document.getElementById("loading-text");
  const unissuedEl = document.getElementById("status-unissued");
  const issuedEl = document.getElementById("status-issued");
  const errorEl = document.getElementById("status-error");
  const errorMsgEl = document.getElementById("error-message");

  const numberEl = document.getElementById("ticket-number");
  const resDateTimeEl = document.getElementById("res-datetime");
  const resChildEl = document.getElementById("res-child");
  const resAdultEl = document.getElementById("res-adult");
  const resNamesRow = document.getElementById("res-names-row");
  const resNamesEl = document.getElementById("res-child-names");
  const resNoteRow = document.getElementById("res-note-row");
  const resNoteEl = document.getElementById("res-note");

  const issueBtn = document.getElementById("btn-issue");
  const btnTitleText = document.getElementById("btn-title-text");
  const clockEl = document.getElementById("live-clock");
  const modeBadgeEl = document.getElementById("mode-badge");
  const turnstileContainer = document.getElementById("turnstile-container");
  const splitWrapper = document.getElementById("split-wrapper");
  const splitCheckbox = document.getElementById("split-ticket-checkbox");
  const noteInput = document.getElementById("ticket-note");

  let turnstileWidgetId = null;
  let turnstileToken = null;
  let lineReady = false;

  let selectedDate = document.querySelector("#date-selector .btn-date.active")?.dataset.date || "2026-10-30";
  let selectedSlotId = "";
  let selectedSlotName = "";
  let selectedChildCount = 1;
  let selectedAdultCount = 1;

  // 🔄 人数に応じた名前入力欄の生成
  function updateChildNameInputs(count) {
    const container = document.getElementById("child-names-container");
    if (!container) return;

    const currentValues = Array.from(container.querySelectorAll(".child-name-input")).map(input => input.value);
    container.innerHTML = "";

    for (let i = 0; i < count; i++) {
      const wrapper = document.createElement("div");
      wrapper.className = "name-input-wrapper";

      const label = document.createElement("span");
      label.className = "name-index";
      label.textContent = `${i + 1}人目`;

      const input = document.createElement("input");
      input.type = "text";
      input.className = "child-name-input code-input";
      input.placeholder = count === 1 ? "例: やまだ たろう" : `例: お子様${i + 1}のお名前`;
      input.maxLength = 30;
      input.value = currentValues[i] || "";

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      container.appendChild(wrapper);
    }
  }

  // 残枠数を取得
  async function fetchSlotAvailability(dateStr) {
    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/api/slots?date=${dateStr}`);
      const data = await res.json();
      
      const slotData = data.slots || [
        { slotId: "slot_1", booked: 0, capacity: MAX_SLOT_CAPACITY },
        { slotId: "slot_2", booked: 0, capacity: MAX_SLOT_CAPACITY },
        { slotId: "slot_3", booked: 0, capacity: MAX_SLOT_CAPACITY }
      ];

      let firstAvailableSelected = false;

      slotData.forEach(s => {
        const badgeEl = document.getElementById(`badge-${s.slotId}`);
        const cardEl = document.querySelector(`[data-slot-id="${s.slotId}"]`);
        if (!badgeEl || !cardEl) return;

        const capacity = s.capacity || MAX_SLOT_CAPACITY;
        const remaining = Math.max(0, capacity - (s.booked || 0));

        if (remaining <= 0) {
          badgeEl.className = "badge-status badge-full";
          badgeEl.textContent = "満席";
          cardEl.classList.add("disabled");
          cardEl.classList.remove("active");
        } else if (remaining <= 3) {
          badgeEl.className = "badge-status badge-warn";
          badgeEl.textContent = `残りわずか (残${remaining}/${capacity}枠)`;
          cardEl.classList.remove("disabled");
        } else {
          badgeEl.className = "badge-status badge-ok";
          badgeEl.textContent = `受付中 (残${remaining}/${capacity}枠)`;
          cardEl.classList.remove("disabled");
        }

        if (remaining > 0 && !firstAvailableSelected) {
          cardEl.classList.add("active");
          selectedSlotId = s.slotId;
          selectedSlotName = cardEl.dataset.slotName;
          firstAvailableSelected = true;
        }
      });
    } catch (err) {
      ["slot_1", "slot_2", "slot_3"].forEach((slotId, index) => {
        const badgeEl = document.getElementById(`badge-${slotId}`);
        const cardEl = document.querySelector(`[data-slot-id="${slotId}"]`);
        if (badgeEl) {
          badgeEl.className = "badge-status badge-ok";
          badgeEl.textContent = `受付中 (残${MAX_SLOT_CAPACITY}/${MAX_SLOT_CAPACITY}枠)`;
        }
        if (cardEl) {
          cardEl.classList.remove("disabled");
          if (index === 0) {
            cardEl.classList.add("active");
            selectedSlotId = slotId;
            selectedSlotName = cardEl.dataset.slotName;
          }
        }
      });
    }
  }

  // イベントリスナー設定
  document.querySelectorAll("#date-selector .btn-date").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#date-selector .btn-date").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      selectedDate = btn.dataset.date;
      fetchSlotAvailability(selectedDate);
    });
  });

  document.querySelectorAll("#slot-selector .slot-card").forEach((card) => {
    card.addEventListener("click", () => {
      if (card.classList.contains("disabled")) return;
      document.querySelectorAll("#slot-selector .slot-card").forEach((c) => c.classList.remove("active"));
      card.classList.add("active");
      selectedSlotId = card.dataset.slotId;
      selectedSlotName = card.dataset.slotName;
    });
  });

  document.querySelectorAll("#child-selector .btn-select").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#child-selector .btn-select").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      selectedChildCount = parseInt(btn.dataset.count, 10);

      updateChildNameInputs(selectedChildCount);

      if (selectedChildCount >= 2) {
        splitWrapper.style.display = "block";
      } else {
        splitWrapper.style.display = "none";
        splitCheckbox.checked = false;
      }
    });
  });

  document.querySelectorAll("#adult-selector .btn-select").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#adult-selector .btn-select").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      selectedAdultCount = parseInt(btn.dataset.count, 10);
    });
  });

  function startClock() {
    function update() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      const ms = String(Math.floor(now.getMilliseconds() / 100));
      if (clockEl) clockEl.textContent = `${h}:${m}:${s}.${ms}`;
      requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  function displayTicket(ticketNo, datetimeStr, child = 1, adult = 0, childNames = "", note = "") {
    if (numberEl) numberEl.innerText = ticketNo;
    if (resDateTimeEl) resDateTimeEl.innerText = datetimeStr;
    if (resChildEl) resChildEl.innerText = `${child}名`;
    if (resAdultEl) resAdultEl.innerText = `${adult}名`;

    if (childNames && resNamesRow && resNamesEl) {
      resNamesEl.innerText = childNames;
      resNamesRow.style.display = "flex";
    } else if (resNamesRow) {
      resNamesRow.style.display = "none";
    }

    if (note && resNoteRow && resNoteEl) {
      resNoteEl.innerText = note;
      resNoteRow.style.display = "flex";
    } else if (resNoteRow) {
      resNoteRow.style.display = "none";
    }

    if (loadingEl) loadingEl.style.display = "none";
    if (unissuedEl) unissuedEl.style.display = "none";
    if (errorEl) errorEl.style.display = "none";
    if (issuedEl) issuedEl.style.display = "block";
    startClock();
  }

  function loadLiffSdk() {
    return new Promise((resolve, reject) => {
      if (window.liff) return resolve(window.liff);
      const script = document.createElement("script");
      script.src = "https://static.line-scdn.net/liff/edge/2/sdk.js";
      script.onload = () => resolve(window.liff);
      script.onerror = () => reject(new Error("LIFF SDK Load Error"));
      document.head.appendChild(script);
    });
  }

  function loadTurnstileSdk() {
    return new Promise((resolve, reject) => {
      if (window.turnstile) return resolve(window.turnstile);
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.defer = true;
      script.onload = () => resolve(window.turnstile);
      script.onerror = () => reject(new Error("Turnstile Error"));
      document.head.appendChild(script);
    });
  }

  async function initTurnstile() {
    if (isDevMode) {
      turnstileToken = "DEV_MODE";
      return;
    }
    if (!turnstileContainer) return;
    turnstileContainer.style.display = "block";

    try {
      const turnstile = await loadTurnstileSdk();
      turnstileWidgetId = turnstile.render(turnstileContainer, {
        sitekey: TURNSTILE_SITE_KEY,
        action: "issue_ticket",
        appearance: "always",
        theme: "light",
        callback: (token) => {
          turnstileToken = token;
          if (issueBtn && lineReady) issueBtn.disabled = false;
        },
        "expired-callback": () => {
          turnstileToken = null;
          if (issueBtn) issueBtn.disabled = true;
        },
        "error-callback": () => {
          turnstileToken = "BYPASS_UNAVAILABLE";
          if (issueBtn && lineReady) issueBtn.disabled = false;
        }
      });
    } catch (err) {
      turnstileToken = "BYPASS_UNAVAILABLE";
      if (issueBtn && lineReady) issueBtn.disabled = false;
    }
  }

  async function init() {
    const cachedNo = localStorage.getItem("shokosai_ticket_no");
    const cachedDateTime = localStorage.getItem("shokosai_ticket_datetime") || "";
    const cachedChild = localStorage.getItem("shokosai_ticket_child") || 1;
    const cachedAdult = localStorage.getItem("shokosai_ticket_adult") || 0;
    const cachedNames = localStorage.getItem("shokosai_ticket_child_names") || "";
    const cachedNote = localStorage.getItem("shokosai_ticket_note") || "";

    if (cachedNo) {
      displayTicket(cachedNo, cachedDateTime, cachedChild, cachedAdult, cachedNames, cachedNote);
      return;
    }

    if (isDevMode) {
      if (modeBadgeEl) {
        modeBadgeEl.textContent = "DIRECT WEB MODE";
        modeBadgeEl.style.color = "#0284c7";
      }
      if (loadingEl) loadingEl.style.display = "none";
      if (unissuedEl) unissuedEl.style.display = "block";
      turnstileToken = "DEV_MODE";
      if (issueBtn) issueBtn.disabled = false;
      await fetchSlotAvailability(selectedDate);
      return;
    }

    try {
      if (loadingTextEl) loadingTextEl.textContent = "VERIFYING LINE TOKEN...";
      const liffObj = await loadLiffSdk();
      await liffObj.init({ liffId: LIFF_ID });

      if (!liffObj.isLoggedIn()) {
        liffObj.login();
        return;
      }

      lineReady = true;
      if (modeBadgeEl) {
        modeBadgeEl.textContent = "LINE CONNECTED";
        modeBadgeEl.style.color = "#059669";
      }
      if (loadingEl) loadingEl.style.display = "none";
      if (unissuedEl) unissuedEl.style.display = "block";

      await initTurnstile();
      if (turnstileToken && issueBtn) issueBtn.disabled = false;
      await fetchSlotAvailability(selectedDate);
    } catch (err) {
      if (loadingEl) loadingEl.style.display = "none";
      if (errorMsgEl) errorMsgEl.innerText = "LINE認証に失敗しました。";
      if (errorEl) errorEl.style.display = "block";
    }
  }

  issueBtn?.addEventListener("click", async () => {
    issueBtn.disabled = true;
    if (btnTitleText) btnTitleText.innerText = "予約処理中...";

    const isSplit = splitCheckbox.checked;
    
    // お子様のお名前（childNames）を取得
    const nameInputs = document.querySelectorAll(".child-name-input");
    const childNamesText = Array.from(nameInputs)
      .map(input => input.value.trim())
      .filter(val => val !== "")
      .join(", ");

    // 備考・ご要望（note）を取得
    const noteText = noteInput.value.trim();
    const datetimeDisplayStr = `${selectedDate} / ${selectedSlotName}`;

    try {
      let payload = {
        date: selectedDate,
        slotId: selectedSlotId,
        childCount: selectedChildCount,
        adultCount: selectedAdultCount,
        childNames: childNamesText,
        splitTicket: isSplit,
        note: noteText,
        headcount: selectedChildCount + selectedAdultCount
      };

      if (isDevMode) {
        let mockUid = localStorage.getItem("mock_shoko_uid");
        if (!mockUid) {
          mockUid = "web_" + crypto.randomUUID();
          localStorage.setItem("mock_shoko_uid", mockUid);
        }
        payload.mockUserId = mockUid;
      } else {
        const idToken = window.liff?.getIDToken();
        if (!idToken || !turnstileToken) throw new Error("AUTH_TOKEN_MISSING");
        payload.idToken = idToken;
        payload.turnstileToken = turnstileToken;
      }

      const res = await fetch(BACKEND_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (data.success) {
        let ticketLabel = `No.${data.ticketNumber}`;
        if (data.ticketNumbers && data.ticketNumbers.length > 1) {
          ticketLabel = data.ticketNumbers.map(n => `No.${n}`).join(", ");
        }

        const resChild = data.childCount || selectedChildCount;
        const resAdult = data.adultCount !== undefined ? data.adultCount : selectedAdultCount;

        localStorage.setItem("shokosai_ticket_no", ticketLabel);
        localStorage.setItem("shokosai_ticket_datetime", datetimeDisplayStr);
        localStorage.setItem("shokosai_ticket_child", resChild);
        localStorage.setItem("shokosai_ticket_adult", resAdult);
        localStorage.setItem("shokosai_ticket_child_names", childNamesText);
        localStorage.setItem("shokosai_ticket_note", noteText);

        displayTicket(ticketLabel, datetimeDisplayStr, resChild, resAdult, childNamesText, noteText);
        turnstileToken = null;
      } else {
        alert(data.message || "予約処理に失敗しました。");
        if (!isDevMode && window.turnstile && turnstileWidgetId !== null && turnstileToken !== "BYPASS_UNAVAILABLE") {
          window.turnstile.reset(turnstileWidgetId);
          turnstileToken = null;
        }
        issueBtn.disabled = !isDevMode && turnstileToken !== "BYPASS_UNAVAILABLE";
        if (btnTitleText) btnTitleText.innerText = "LINEで整理券を予約する";
      }
    } catch (err) {
      alert("通信エラーが発生しました。");
      issueBtn.disabled = false;
      if (btnTitleText) btnTitleText.innerText = "LINEで整理券を予約する";
    }
  });

  window.addEventListener("load", init);
</script>

