---
import Layout from '../layouts/Layout.astro';

const EVENT_DATES = [
  { date: '2026-10-30', label: '10/30 (金)' },
  { date: '2026-10-31', label: '10/31 (土)' },
];

const TIME_SLOTS = [
  { id: 'slot_1', name: '第一回', time: '10:00〜11:00' },
  { id: 'slot_2', name: '第二回', time: '11:30〜12:30' },
  { id: 'slot_3', name: '第三回', time: '13:00〜14:00' },
];
---

<Layout title="プログラミング体験会 整理券予約 | 第7回商工祭">
  <div class="bright-code-portal">
    <header class="terminal-header">
      <div class="header-badge">&lt;PROGRAMMING_BOOTH /&gt;</div>
      <h1>日時指定 整理券予約</h1>
      <p class="terminal-subtitle">SMART SCHEDULE // 個人情報は最小限</p>
    </header>

    <main class="portal-container">
      <div class="editor-window">
        <div class="window-titlebar">
          <span class="tab-title">calendar_reservation.ts</span>
          <span class="mode-tag" id="mode-badge">CONNECTING...</span>
        </div>

        <!-- ① 入力フォーム -->
        <div id="status-unissued" class="editor-body">
          <div class="field-block">
            <div class="field-header">
              <span class="step-num">1</span>
              <label class="field-label">ご来場タイプの選択</label>
              <span class="code-tag">&lt;type /&gt;</span>
            </div>
            <div class="selector-grid" id="visitor-type-selector">
              <button type="button" class="btn-select active" data-type="family">👨‍👩‍👧‍👦 ご家族連れ</button>
              <button type="button" class="btn-select" data-type="general">👤 一般・個人</button>
            </div>
          </div>

          <div class="field-block">
            <div class="field-header">
              <span class="step-num">2</span>
              <label class="field-label">体験希望日の選択</label>
              <span class="code-tag">&lt;date /&gt;</span>
            </div>
            <div class="date-grid" id="date-selector">
              {EVENT_DATES.map((d, index) => (
                <button type="button" class={`btn-date ${index === 0 ? 'active' : ''}`} data-date={d.date}>
                  <span class="date-label">{d.label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="field-block">
            <div class="field-header">
              <span class="step-num">3</span>
              <label class="field-label">時間帯の選択 (1日3回)</label>
              <span class="code-tag">&lt;timeslot /&gt;</span>
            </div>
            <div class="slot-list" id="slot-selector">
              {TIME_SLOTS.map((s, index) => (
                <div class={`slot-card ${index === 0 ? 'active' : ''}`} data-slot-id={s.id} data-slot-name={`${s.name} (${s.time})`}>
                  <div class="slot-info">
                    <span class="slot-title">{s.name}</span>
                    <span class="slot-time">{s.time}</span>
                  </div>
                  <div class="slot-status">
                    <span class="badge-status badge-ok" id={`badge-${s.id}`}>確認中...</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="field-block" id="parent-name-block">
            <div class="field-header">
              <span class="step-num">4</span>
              <label class="field-label">保護者様のお名前</label>
              <span class="code-tag">&lt;guardian /&gt;</span>
            </div>
            <input 
              type="text" 
              id="parent-name-input" 
              class="code-input" 
              placeholder="例: やまだ たろう（保護者様）" 
              maxlength="30" 
            />
          </div>

          <div class="field-block">
            <div class="field-header">
              <span class="step-num">5</span>
              <label class="field-label">体験する方の人数</label>
              <span class="code-tag">&lt;count /&gt;</span>
            </div>
            <div class="selector-grid" id="participant-count-selector">
              <button type="button" class="btn-select active" data-count="1">1名</button>
              <button type="button" class="btn-select" data-count="2">2名</button>
              <button type="button" class="btn-select" data-count="3">3名</button>
              <button type="button" class="btn-select" data-count="4">4名</button>
              <button type="button" class="btn-select" data-count="custom">5名〜</button>
            </div>
            <div id="custom-count-wrapper" class="custom-input-box" style="display: none;">
              <label for="custom-count-input">体験人数を入力してください：</label>
              <div class="input-with-unit">
                <input type="number" id="custom-count-input" class="code-input" min="5" max="15" value="5" />
                <span class="unit">名</span>
              </div>
            </div>
          </div>

          <div class="field-block">
            <div class="field-header">
              <span class="step-num">6</span>
              <label class="field-label">体験する方のお名前 <span class="sub-label">（任意）</span></label>
              <span class="code-tag">&lt;names /&gt;</span>
            </div>
            <div id="participant-names-container" class="names-container">
              <div class="name-input-wrapper">
                <span class="name-index">1人目</span>
                <input type="text" class="participant-name-input code-input" placeholder="例: やまだ はなこ" maxlength="30" />
              </div>
            </div>
          </div>

          <p id="issue-error-msg" class="error-message" style="display: none;"></p>

          <button id="btn-issue" class="terminal-btn">
            <span id="btn-title-text" class="btn-title">LINEで整理券を発行する</span>
          </button>
        </div>

        <!-- ② 完了画面 -->
        <div id="status-issued" class="editor-body" style="display: none;">
          <div class="terminal-success-badge">
            <span class="pulse-dot"></span> RESERVATION CONFIRMED
          </div>

          <div class="ticket-card-display">
            <span class="ticket-card-label">受付提示用 整理券</span>
            <div class="ticket-number-box">
              <span class="num-prefix">No.</span>
              <span id="ticket-number" class="ticket-num">--</span>
            </div>

            <div class="barcode-box">
              <svg id="barcode-svg"></svg>
              <span class="barcode-caption">※受付でこのバーコードを提示（またはスキャン）</span>
            </div>
          </div>

          <div class="screenshot-alert">
            <span class="alert-icon">📱</span>
            <p><strong>【スクリーンショット保存のお願い】</strong><br>会場での通信混雑に備え、この画面（整理券番号・バーコード）を<strong>写真保存（スクショ）</strong>してお越しください。</p>
          </div>

          <div class="ticket-meta-box">
            <div class="meta-row">
              <span class="meta-key">来場タイプ:</span>
              <span id="res-type" class="meta-val">ご家族連れ</span>
            </div>
            <div class="meta-row" id="res-parent-row">
              <span class="meta-key">保護者様名:</span>
              <span id="res-parent-name" class="meta-val">--</span>
            </div>
            <div class="meta-row">
              <span class="meta-key">予約日時:</span>
              <span id="res-datetime" class="meta-val">--</span>
            </div>
            <div class="meta-row">
              <span class="meta-key">体験人数:</span>
              <span id="res-count" class="meta-val">1名</span>
            </div>
            <div class="meta-row" id="res-names-row">
              <span class="meta-key">体験する方:</span>
              <span id="res-participant-names" class="meta-val">--</span>
            </div>
          </div>

          <div class="remind-info-card">
            <span class="remind-icon">💬</span>
            <div class="remind-text">
              <strong>LINE自動リマインド設定完了</strong>
              <p>体験開始の<strong>5分前</strong>にLINEへ呼び出し通知が送信されます。</p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const BACKEND_ENDPOINT = "https://ticket-api.zinn1019t.workers.dev";

  let selectedVisitorType = "family";
  let selectedDate = "2026-10-30";
  let selectedSlotId = "slot_1";
  let currentParticipantCount = 1;
  let lineIdToken = null;

  const visitorTypeBtns = document.querySelectorAll("#visitor-type-selector .btn-select");
  const dateBtns = document.querySelectorAll("#date-selector .btn-date");
  const slotCards = document.querySelectorAll("#slot-selector .slot-card");
  const parentNameBlock = document.getElementById("parent-name-block");
  const parentNameInput = document.getElementById("parent-name-input");
  
  const countBtns = document.querySelectorAll("#participant-count-selector .btn-select");
  const customCountWrapper = document.getElementById("custom-count-wrapper");
  const customCountInput = document.getElementById("custom-count-input");
  const issueBtn = document.getElementById("btn-issue");
  const btnTitleText = document.getElementById("btn-title-text");
  const errorMsgEl = document.getElementById("issue-error-msg");
  const modeBadge = document.getElementById("mode-badge");

  const isDevMode = new URLSearchParams(window.location.search).get("dev") === "true";

  // モード設定 ＆ 初期データ取得
  if (isDevMode && modeBadge) {
    modeBadge.textContent = "DEV MOCK MODE";
    modeBadge.style.background = "#fef3c7";
    modeBadge.style.color = "#b45309";
  } else {
    if (modeBadge) modeBadge.textContent = "ONLINE";
    
    window.addEventListener("DOMContentLoaded", () => {
      const script = document.createElement("script");
      script.src = "https://static.line-scdn.net/liff/edge/2/sdk.js";
      script.onload = async () => {
        if (window.liff) {
          try {
            await liff.init({ liffId: "YOUR_LIFF_ID" });
            if (liff.isLoggedIn()) {
              lineIdToken = liff.getIDToken();
            } else {
              liff.login();
            }
          } catch (err) {
            console.error("LIFF Init Error:", err);
          }
        }
      };
      document.head.appendChild(script);
    });
  }

  // 残り枠数を API から取得して画面に反映
  async function fetchSlotAvailability(date) {
    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/api/slots?date=${date}`);
      const data = await res.json();

      if (res.ok && data.success && data.slots) {
        data.slots.forEach(s => {
          const badgeEl = document.getElementById(`badge-${s.slotId}`);
          const cardEl = document.querySelector(`.slot-card[data-slot-id="${s.slotId}"]`);

          if (badgeEl) {
            if (s.isFull) {
              badgeEl.textContent = "満席";
              badgeEl.className = "badge-status badge-full";
              if (cardEl) cardEl.classList.add("disabled");
            } else {
              badgeEl.textContent = `受付中 (残${s.remaining}/${s.capacity}枠)`;
              badgeEl.className = "badge-status badge-ok";
              if (cardEl) cardEl.classList.remove("disabled");
            }
          }
        });
      }
    } catch (e) {
      console.error("Failed to fetch slots:", e);
    }
  }

  // 初期読み込み
  fetchSlotAvailability(selectedDate);

  visitorTypeBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      visitorTypeBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      selectedVisitorType = btn.dataset.type || "family";

      if (parentNameBlock) {
        if (selectedVisitorType === "family") {
          parentNameBlock.style.display = "block";
        } else {
          parentNameBlock.style.display = "none";
          if (parentNameInput) parentNameInput.value = "";
        }
      }
    });
  });

  dateBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      dateBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      selectedDate = btn.dataset.date || "2026-10-30";
      fetchSlotAvailability(selectedDate);
    });
  });

  slotCards.forEach(card => {
    card.addEventListener("click", () => {
      if (card.classList.contains("disabled")) return;
      slotCards.forEach(c => c.classList.remove("active"));
      card.classList.add("active");
      selectedSlotId = card.dataset.slotId || "slot_1";
    });
  });

  function updateParticipantNameInputs(count) {
    const container = document.getElementById("participant-names-container");
    if (!container) return;

    const currentInputs = container.querySelectorAll(".participant-name-input");
    const currentValues = Array.from(currentInputs).map(i => i.value);
    container.innerHTML = "";

    for (let i = 0; i < count; i++) {
      const wrapper = document.createElement("div");
      wrapper.className = "name-input-wrapper";

      const label = document.createElement("span");
      label.className = "name-index";
      label.textContent = `${i + 1}人目`;

      const input = document.createElement("input");
      input.type = "text";
      input.className = "participant-name-input code-input";
      input.placeholder = `体験者${i + 1}のお名前`;
      input.maxLength = 30;
      input.value = currentValues[i] || "";

      wrapper.appendChild(label);
      wrapper.appendChild(input);
      container.appendChild(wrapper);
    }
  }

  countBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      countBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const val = btn.dataset.count;
      if (val === "custom") {
        if (customCountWrapper) customCountWrapper.style.display = "block";
        currentParticipantCount = Math.max(5, parseInt(customCountInput?.value || "5", 10) || 5);
      } else {
        if (customCountWrapper) customCountWrapper.style.display = "none";
        currentParticipantCount = parseInt(val || "1", 10);
      }

      updateParticipantNameInputs(currentParticipantCount);
    });
  });

  customCountInput?.addEventListener("input", (e) => {
    let val = parseInt(e.target.value, 10);
    if (isNaN(val) || val < 1) val = 1;
    if (val > 15) val = 15;
    currentParticipantCount = val;
    updateParticipantNameInputs(currentParticipantCount);
  });

  function renderCode128SVG(svgEl, text) {
    const patterns = [
      "212222","222122","222221","121223","121322","131222","122213","122312","132212","221213",
      "221312","231212","112232","122132","122231","113222","123122","123221","223211","221132",
      "221231","213212","223112","312131","311222","321122","321221","312212","322112","322211",
      "212123","212321","232121","111323","131123","131321","112313","132113","132311","211313",
      "231113","231311","112133","112331","132131","113123","113321","133121","313121","211331",
      "231131","213113","213311","213131","311123","311321","331121","312113","312311","332111",
      "314111","221411","431111","111224","111422","121124","121421","141122","141221","112214",
      "112412","122114","122411","142112","142211","241211","221114","413111","241112","134111",
      "111242","121142","121241","114212","124112","124211","411212","421112","421211","212141",
      "214121","412121","111143","111341","131141","114113","114311","411113","411311","113141",
      "114131","311141","411111","211412","211214","211232","2331112"
    ];

    const codes = [104];
    let checksum = 104;

    for (let i = 0; i < text.length; i++) {
      const code = text.charCodeAt(i) - 32;
      if (code >= 0 && code <= 95) {
        codes.push(code);
        checksum += code * (i + 1);
      }
    }

    codes.push(checksum % 103);
    codes.push(106);

    let bars = "";
    for (let c of codes) bars += patterns[c];

    const moduleWidth = 2;
    const height = 50;
    let x = 10;
    let rects = "";
    let isBar = true;

    for (let i = 0; i < bars.length; i++) {
      const w = parseInt(bars[i], 10) * moduleWidth;
      if (isBar) rects += `<rect x="${x}" y="10" width="${w}" height="${height}" fill="#000" />`;
      x += w;
      isBar = !isBar;
    }

    const totalWidth = x + 10;
    const totalHeight = height + 35;

    svgEl.setAttribute("viewBox", `0 0 ${totalWidth} ${totalHeight}`);
    svgEl.removeAttribute("height");
    svgEl.innerHTML = `${rects}<text x="${totalWidth / 2}" y="${height + 25}" font-size="14" font-weight="bold" font-family="monospace" text-anchor="middle" fill="#000">${text}</text>`;
  }

  function showError(msg) {
    if (errorMsgEl) {
      errorMsgEl.textContent = msg;
      errorMsgEl.style.display = "block";
    }
  }

  function hideError() {
    if (errorMsgEl) {
      errorMsgEl.style.display = "none";
    }
  }

  issueBtn?.addEventListener("click", async () => {
    hideError();

    const parentName = parentNameInput?.value.trim() || "";
    if (selectedVisitorType === "family" && !parentName) {
      showError("保護者様のお名前を入力してください");
      return;
    }

    const nameInputs = document.querySelectorAll(".participant-name-input");
    const participantNamesText = Array.from(nameInputs)
      .map(input => input.value.trim())
      .filter(v => v !== "")
      .join(", ");

    issueBtn.disabled = true;
    if (btnTitleText) btnTitleText.textContent = "整理券を発行中...";

    const payload = {
      date: selectedDate,
      slotId: selectedSlotId,
      visitorType: selectedVisitorType,
      headcount: currentParticipantCount,
      parentName: parentName,
      participantNames: participantNamesText,
      ...(isDevMode ? { mockUserId: "web_dev_user_001" } : { idToken: lineIdToken })
    };

    try {
      const res = await fetch(`${BACKEND_ENDPOINT}/`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (res.ok && data.success) {
        const ticketNo = String(data.ticketNumber);
        const barcodeText = `SHOKO-${ticketNo}`;

        const numEl = document.getElementById("ticket-number");
        if (numEl) numEl.innerText = ticketNo;

        const svgEl = document.getElementById("barcode-svg");
        if (svgEl) renderCode128SVG(svgEl, barcodeText);

        const resTypeEl = document.getElementById("res-type");
        if (resTypeEl) resTypeEl.innerText = selectedVisitorType === "family" ? "ご家族連れ" : "一般・個人";
        
        const parentRow = document.getElementById("res-parent-row");
        const parentNameValEl = document.getElementById("res-parent-name");
        if (selectedVisitorType === "family" && parentName) {
          if (parentRow) parentRow.style.display = "flex";
          if (parentNameValEl) parentNameValEl.innerText = parentName;
        } else {
          if (parentRow) parentRow.style.display = "none";
        }

        const dtEl = document.getElementById("res-datetime");
        if (dtEl) dtEl.innerText = `${selectedDate} / ${selectedSlotId}`;

        const countEl = document.getElementById("res-count");
        if (countEl) countEl.innerText = `${currentParticipantCount}名`;

        const namesRow = document.getElementById("res-names-row");
        const namesValEl = document.getElementById("res-participant-names");
        if (participantNamesText) {
          if (namesRow) namesRow.style.display = "flex";
          if (namesValEl) namesValEl.innerText = participantNamesText;
        } else {
          if (namesRow) namesRow.style.display = "none";
        }

        const unissuedEl = document.getElementById("status-unissued");
        const issuedEl = document.getElementById("status-issued");
        if (unissuedEl) unissuedEl.style.display = "none";
        if (issuedEl) issuedEl.style.display = "block";
      } else {
        showError(data.message || "整理券の発行に失敗しました");
      }
    } catch (e) {
      console.error(e);
      showError("通信エラーが発生しました。インターネット接続を確認してください。");
    } finally {
      issueBtn.disabled = false;
      if (btnTitleText) btnTitleText.textContent = "LINEで整理券を発行する";
    }
  });
</script>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: #f8fafc;
    color: #1e293b;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .bright-code-portal {
    min-height: 100vh;
    padding: 24px 16px 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .terminal-header {
    width: 100%;
    max-width: 440px;
    text-align: center;
    margin-bottom: 20px;
  }

  .header-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    color: #0284c7;
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 8px;
  }

  .terminal-header h1 {
    font-size: 1.45rem;
    margin: 0;
    color: #0f172a;
    font-weight: 900;
  }

  .terminal-subtitle {
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 4px;
    font-weight: 700;
  }

  .portal-container { width: 100%; max-width: 440px; }

  .editor-window {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .window-titlebar {
    background: #f8fafc;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
  }

  .tab-title { font-size: 0.75rem; color: #64748b; font-weight: 600; }
  .mode-tag { margin-left: auto; font-size: 0.68rem; font-weight: 800; color: #0284c7; background: #e0f2fe; padding: 2px 8px; border-radius: 4px; }

  .editor-body { padding: 22px 18px; }

  .field-block { margin-bottom: 18px; }
  .field-header { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }

  .step-num {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .field-label { font-size: 0.88rem; font-weight: 800; color: #0f172a; }
  .sub-label { font-size: 0.75rem; color: #64748b; font-weight: normal; }
  .code-tag { margin-left: auto; font-size: 0.68rem; color: #0284c7; background: #e0f2fe; padding: 1px 6px; border-radius: 4px; font-family: monospace; }

  .selector-grid { display: flex; gap: 6px; }
  .btn-select {
    flex: 1;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    color: #475569;
    padding: 10px 0;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-select.active { background: #0284c7; border-color: #0284c7; color: #ffffff; }

  .date-grid { display: flex; gap: 8px; }
  .btn-date {
