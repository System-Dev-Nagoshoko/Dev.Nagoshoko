---
import Layout from '../layouts/Layout.astro';
---

<Layout title="整理券発行 | 第7回商工祭">
  <div class="cyber-portal">
    <div class="digital-bg"></div>
    <div class="neon-glow"></div>

    <header class="cyber-header">
      <div class="header-line"></div>
      <h1>整理券発行システム <span class="ver">v2.0</span></h1>
      <p class="cyber-subtitle">SMART TICKETING // NO PERSONAL DATA</p>
    </header>

    <main class="portal-container">
      <div class="crystal c-1"><div class="crystal-core"></div></div>
      <div class="crystal c-2"><div class="crystal-core shadow-core"></div></div>
      <div class="crystal c-3"><div class="crystal-core"></div></div>
      <div class="crystal c-4"><div class="crystal-core shadow-core"></div></div>

      <div class="ticket-card">
        <div class="tile-edge"></div>

        <!-- ① 初期読み込み中表示 -->
        <div id="status-loading" class="panel-section">
          <div class="cyber-scanner">
            <div class="scan-beam"></div>
          </div>
          <p id="loading-text" class="scanning-text">CONNECTING...</p>
        </div>

        <!-- ② 未発券状態（発券ボタン） -->
        <div id="status-unissued" class="panel-section" style="display: none;">
          <div class="status-badge" id="mode-badge">TICKET SYSTEM</div>
          <h2 class="card-headline">整理券</h2>
          
          <div class="guide-box">
            <div class="guide-item">
              <span class="guide-bullet">🛡️</span>
              <p>氏名・電話番号等の<strong>個人情報は一切取得しません</strong>。</p>
            </div>
            <div class="guide-item">
              <span class="guide-bullet">📱</span>
              <p id="guide-notice-text">順番が近づきましたら画面上（または公式LINE）でお知らせします。</p>
            </div>
            <div class="guide-item">
              <span class="guide-bullet">🚶</span>
              <p>整理券取得後は、お呼び出しまで校内をご自由にお回りいただけます。</p>
            </div>
          </div>

          <!-- Cloudflare Turnstile コンテナ -->
          <div
            id="turnstile-container"
            class="turnstile-container"
            style="display: none;"
          ></div>

          <button id="btn-issue" class="cyber-issue-btn" disabled>
            <span class="btn-icon">🎟️</span>
            <span id="btn-title-text" class="btn-title">整理券を取得する</span>
          </button>
        </div>

        <!-- ③ 発券完了状態（番号 ＆ 照合時計） -->
        <div id="status-issued" class="panel-section" style="display: none;">
          <div class="status-badge live-badge">
            <span class="pulse-dot"></span> TICKET VERIFIED
          </div>

          <p class="ticket-sublabel">あなたの整理券番号</p>
          <div class="number-wrapper">
            <span class="num-prefix">No.</span>
            <span id="ticket-number" class="ticket-num">--</span>
          </div>

          <div class="live-clock-card">
            <span class="clock-label">CURRENT TIME // 照合用</span>
            <div id="live-clock" class="clock-display">--:--:--.--</div>
          </div>

          <div class="flow-message">
            <p>※順番になりましたら、入口受付にてこの画面をご提示ください。</p>
          </div>
        </div>

        <!-- ④ エラー表示 -->
        <div id="status-error" class="panel-section" style="display: none;">
          <div class="status-badge error-badge">ERROR</div>
          <p id="error-message" class="error-text">通信エラーが発生しました。</p>
          <button class="cyber-retry-btn" onclick="location.reload()">再読み込み</button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const LIFF_ID = "2011672035-MlQEQgzQ";
  const BACKEND_ENDPOINT = "https://ticket-api.zinn1019t.workers.dev";
  const TURNSTILE_SITE_KEY = "0x4AAAAAAE82keLXX6udcUpX";

  const urlParams = new URLSearchParams(window.location.search);
  const isDevMode = 
    urlParams.get("dev") === "true" || 
    window.location.hostname === "localhost" || 
    window.location.hostname === "127.0.0.1";

  const loadingEl = document.getElementById("status-loading");
  const loadingTextEl = document.getElementById("loading-text");
  const unissuedEl = document.getElementById("status-unissued");
  const issuedEl = document.getElementById("status-issued");
  const errorEl = document.getElementById("status-error");
  const errorMsgEl = document.getElementById("error-message");
  const numberEl = document.getElementById("ticket-number");
  const issueBtn = document.getElementById("btn-issue");
  const btnTitleText = document.getElementById("btn-title-text");
  const clockEl = document.getElementById("live-clock");
  const modeBadgeEl = document.getElementById("mode-badge");
  const turnstileContainer = document.getElementById("turnstile-container");

  let turnstileWidgetId = null;
  let turnstileToken = null;
  let lineReady = false;

  function startClock() {
    function update() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      const ms = String(Math.floor(now.getMilliseconds() / 100));
      if (clockEl) {
        clockEl.textContent = `${h}:${m}:${s}.${ms}`;
      }
      requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  function displayTicket(ticketNo) {
    if (numberEl) numberEl.innerText = ticketNo;
    if (loadingEl) loadingEl.style.display = "none";
    if (unissuedEl) unissuedEl.style.display = "none";
    if (errorEl) errorEl.style.display = "none";
    if (issuedEl) issuedEl.style.display = "block";
    startClock();
  }

  function loadLiffSdk() {
    return new Promise((resolve, reject) => {
      if (window.liff) return resolve(window.liff);
      const script = document.createElement("script");
      script.src = "https://static.line-scdn.net/liff/edge/2/sdk.js";
      script.onload = () => resolve(window.liff);
      script.onerror = () => reject(new Error("LIFF SDK Load Error"));
      document.head.appendChild(script);
    });
  }

  function loadTurnstileSdk() {
    return new Promise((resolve, reject) => {
      if (window.turnstile) {
        resolve(window.turnstile);
        return;
      }

      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.defer = true;

      script.onload = () => {
        if (window.turnstile) {
          resolve(window.turnstile);
        } else {
          reject(new Error("Turnstile SDK unavailable"));
        }
      };

      script.onerror = () => {
        reject(new Error("Turnstile SDK Load Error"));
      };

      document.head.appendChild(script);
    });
  }

  async function initTurnstile() {
    if (isDevMode) {
      turnstileToken = "DEV_MODE";
      return;
    }

    if (!turnstileContainer) return;
    turnstileContainer.style.display = "block";

    try {
      const turnstile = await loadTurnstileSdk();

      turnstileWidgetId = turnstile.render(turnstileContainer, {
        sitekey: TURNSTILE_SITE_KEY,
        action: "issue_ticket",
        appearance: "always",
        theme: "light",
        callback: (token) => {
          turnstileToken = token;
          if (issueBtn && lineReady) {
            issueBtn.disabled = false;
          }
        },
        "expired-callback": () => {
          turnstileToken = null;
          if (issueBtn) issueBtn.disabled = true;
        },
        "error-callback": (code) => {
          console.warn("Turnstile Verification Warning (Bypassing):", code);

          // エラーが発生した場合は再試行ループを止めるためウィジェットを破棄
          try {
            if (turnstileWidgetId !== null && window.turnstile) {
              window.turnstile.remove(turnstileWidgetId);
              turnstileWidgetId = null;
            }
          } catch (e) {}

          turnstileToken = "BYPASS_UNAVAILABLE";
          if (turnstileContainer) {
            turnstileContainer.style.display = "none";
            turnstileContainer.innerHTML = "";
          }

          // LINE認証が完了していれば発券ボタンを有効化
          if (issueBtn && lineReady) {
            issueBtn.disabled = false;
          }
        }
      });
    } catch (err) {
      console.warn("Turnstile Mount Error (Bypassing):", err);
      turnstileToken = "BYPASS_UNAVAILABLE";
      if (turnstileContainer) {
        turnstileContainer.style.display = "none";
        turnstileContainer.innerHTML = "";
      }
      if (issueBtn && lineReady) {
        issueBtn.disabled = false;
      }
    }
  }

  async function init() {
    const cachedNo = localStorage.getItem("shokosai_ticket_no");
    if (cachedNo) {
      displayTicket(cachedNo);
      return;
    }

    // 開発モード（?dev=true または ローカルホスト）
    if (isDevMode) {
      console.warn("⚠️ [DEV MODE] ?dev=true 検知：LIFFをスキップしてWebモードで起動します。");
      if (modeBadgeEl) {
        modeBadgeEl.textContent = "DIRECT WEB MODE";
        modeBadgeEl.style.background = "#e0f2fe";
        modeBadgeEl.style.color = "#0369a1";
      }
      if (btnTitleText) btnTitleText.textContent = "整理券を発行する";
      if (loadingEl) loadingEl.style.display = "none";
      if (unissuedEl) unissuedEl.style.display = "block";

      turnstileToken = "DEV_MODE";
      if (issueBtn) issueBtn.disabled = false;
      return;
    }

    // 本番環境（LINE LIFF 認証）
    try {
      if (loadingTextEl) loadingTextEl.textContent = "LINE AUTHENTICATING...";
      const liffObj = await loadLiffSdk();
      await liffObj.init({ liffId: LIFF_ID });

      if (!liffObj.isLoggedIn()) {
        liffObj.login();
        return;
      }

      lineReady = true;

      if (modeBadgeEl) modeBadgeEl.textContent = "LINE CONNECTED";
      if (btnTitleText) btnTitleText.textContent = "LINEで整理券を取得";
      if (loadingEl) loadingEl.style.display = "none";
      if (unissuedEl) unissuedEl.style.display = "block";

      await initTurnstile();

      if (turnstileToken && issueBtn) {
        issueBtn.disabled = false;
      }
    } catch (err) {
      console.error("LIFF Init Error:", err);
      if (loadingEl) loadingEl.style.display = "none";
      if (errorMsgEl) errorMsgEl.innerText = "LINE認証の初期化に失敗しました。";
      if (errorEl) errorEl.style.display = "block";
    }
  }

  issueBtn?.addEventListener("click", async () => {
    issueBtn.disabled = true;
    if (btnTitleText) btnTitleText.innerText = "発券処理中...";

    try {
      let payload = {};

      if (isDevMode) {
        let mockUid = localStorage.getItem("mock_shoko_uid");
        if (!mockUid) {
          mockUid = "web_" + crypto.randomUUID();
          localStorage.setItem("mock_shoko_uid", mockUid);
        }
        payload = { mockUserId: mockUid };
      } else {
        const idToken = window.liff?.getIDToken();

        if (!idToken) {
          throw new Error("LINE ID Token unavailable");
        }

        if (!turnstileToken) {
          throw new Error("Turnstile verification required");
        }

        payload = {
          idToken,
          turnstileToken
        };
      }

      const res = await fetch(BACKEND_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (data.success) {
        localStorage.setItem("shokosai_ticket_no", data.ticketNumber);
        displayTicket(data.ticketNumber);
        turnstileToken = null;
      } else {
        alert(data.message || "発券に失敗しました。");

        if (!isDevMode && window.turnstile && turnstileWidgetId !== null) {
          try {
            window.turnstile.reset(turnstileWidgetId);
          } catch (e) {}
          turnstileToken = null;
        }

        issueBtn.disabled = !isDevMode && turnstileToken !== "BYPASS_UNAVAILABLE";
        if (btnTitleText) {
          btnTitleText.innerText = isDevMode ? "整理券を発行する" : "LINEで整理券を取得";
        }
      }
    } catch (err) {
      console.error("Ticket issue error:", err);
      alert("通信エラーが発生しました。");

      if (!isDevMode && window.turnstile && turnstileWidgetId !== null) {
        try {
          window.turnstile.reset(turnstileWidgetId);
        } catch (e) {}
        turnstileToken = null;
      }

      issueBtn.disabled = !isDevMode && turnstileToken !== "BYPASS_UNAVAILABLE";
      if (btnTitleText) {
        btnTitleText.innerText = isDevMode ? "整理券を発行する" : "LINEで整理券を取得";
      }
    }
  });

  window.addEventListener("load", init);
</script>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .cyber-portal {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    padding: clamp(16px, 4vw, 36px) clamp(12px, 3.5vw, 24px) clamp(60px, 10vh, 100px);
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .digital-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: -2;
    pointer-events: none;
  }

  .neon-glow {
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(6, 199, 85, 0.05) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
  }

  .cyber-header {
    width: 100%;
    max-width: 440px;
    text-align: center;
    margin-bottom: clamp(18px, 4vh, 30px);
    padding-top: clamp(8px, 2.5vh, 20px);
  }

  .header-line {
    width: 40px;
    height: 4px;
    background: #06c755;
    margin: 0 auto clamp(10px, 2vh, 15px);
    box-shadow: 0 2px 8px rgba(6, 199, 85, 0.3);
    border-radius: 2px;
  }

  .cyber-header h1 {
    font-size: clamp(1.15rem, 4.2vw, 1.4rem);
    font-weight: 900;
    margin: 0;
    letter-spacing: 0.05em;
    color: #1e3a8a;
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .ver {
    font-size: 0.72em;
    vertical-align: top;
    color: #06c755;
    white-space: nowrap;
  }

  .cyber-subtitle {
    font-size: clamp(0.65rem, 2.4vw, 0.75rem);
    color: #64748b;
    opacity: 0.8;
    letter-spacing: clamp(0.08em, 0.8vw, 0.15em);
    margin-top: 5px;
    font-weight: 600;
  }

  .portal-container {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .crystal {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .c-1 {
    top: -15px;
    left: clamp(-18px, -4vw, -25px);
    width: clamp(22px, 5vw, 30px);
    height: clamp(38px, 8vw, 50px);
    animation: float1 4s infinite ease-in-out;
  }
  .c-2 {
    top: 110px;
    right: clamp(-18px, -4vw, -30px);
    width: clamp(18px, 4vw, 22px);
    height: clamp(30px, 6.5vw, 38px);
    opacity: 0.7;
    animation: float2 5s infinite ease-in-out;
  }
  .c-3 {
    bottom: 70px;
    left: clamp(-18px, -4vw, -30px);
    width: clamp(18px, 4vw, 24px);
    height: clamp(32px, 7vw, 42px);
    opacity: 0.75;
    animation: float3 4.5s infinite ease-in-out;
  }
  .c-4 {
    bottom: -10px;
    right: clamp(-18px, -4vw, -25px);
    width: clamp(20px, 4.5vw, 28px);
    height: clamp(36px, 7.5vw, 48px);
    animation: float4 4.2s infinite ease-in-out;
  }

  .crystal-core {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(6, 199, 85, 0.6) 0%, rgba(0, 180, 216, 0.5) 100%);
    clip-path: polygon(50% 0%, 100% 35%, 100% 65%, 50% 100%, 0% 65%, 0% 35%);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .shadow-core {
    background: linear-gradient(135deg, rgba(0, 180, 216, 0.5) 0%, rgba(114, 9, 183, 0.45) 100%);
  }

  @keyframes float1 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes float2 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8px); } }
  @keyframes float3 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @keyframes float4 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(7px); } }

  .ticket-card {
    position: relative;
    width: 100%;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: clamp(14px, 3.5vw, 18px);
    padding: clamp(24px, 6vw, 36px) clamp(16px, 5vw, 24px) clamp(20px, 5vw, 28px);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    z-index: 2;
    text-align: center;
  }

  .tile-edge {
    position: absolute;
    top: 0;
    left: 0;
    width: 14px;
    height: 14px;
    border-top: 3px solid #06c755;
    border-left: 3px solid #06c755;
    border-top-left-radius: 4px;
  }

  .card-headline {
    margin: 8px 0 clamp(12px, 3vh, 16px);
    font-size: clamp(1.1rem, 3.8vw, 1.25rem);
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 4px 12px;
    font-size: clamp(0.62rem, 2vw, 0.68rem);
    font-weight: 800;
    letter-spacing: 0.05em;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
    margin-bottom: 8px;
    max-width: 100%;
    word-break: break-word;
  }

  .live-badge {
    background: rgba(6, 199, 85, 0.1);
    color: #059669;
  }

  .error-badge {
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
  }

  .guide-box {
    text-align: left;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: clamp(12px, 3.5vw, 16px) clamp(10px, 3vw, 14px);
    margin-bottom: clamp(16px, 4vh, 24px);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 2vw, 12px);
  }

  .guide-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: clamp(0.76rem, 2.5vw, 0.83rem);
    line-height: 1.5;
    color: #475569;
  }

  .guide-item p {
    margin: 0;
    flex: 1;
    overflow-wrap: break-word;
  }

  .guide-item strong {
    color: #0f172a;
  }

  .guide-bullet {
    font-size: clamp(0.85rem, 2.8vw, 0.95rem);
    line-height: 1.3;
    flex-shrink: 0;
  }

  .turnstile-container {
    margin: 0 auto clamp(12px, 3vh, 18px);
    min-height: 65px;
    display: flex;
    justify-content: center;
    max-width: 100%;
    overflow: hidden;
  }

  .cyber-issue-btn {
    width: 100%;
    min-height: 48px;
    padding: clamp(12px, 3.5vw, 16px) clamp(14px, 4vw, 20px);
    background: linear-gradient(135deg, #06c755 0%, #05a746 100%);
    color: #ffffff;
    border: none;
    border-radius: clamp(10px, 2.5vw, 12px);
    font-size: clamp(0.92rem, 3.2vw, 1.05rem);
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(6, 199, 85, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .cyber-issue-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(6, 199, 85, 0.45);
  }

  .cyber-issue-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .cyber-issue-btn:disabled {
    background: #94a3b8;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .btn-title {
    overflow-wrap: break-word;
    line-height: 1.3;
  }

  .btn-icon {
    flex-shrink: 0;
  }

  .ticket-sublabel {
    font-size: clamp(0.78rem, 2.6vw, 0.85rem);
    font-weight: 700;
    color: #64748b;
    margin: clamp(8px, 2vh, 12px) 0 0;
  }

  .number-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: clamp(4px, 1.5vw, 8px);
    margin: clamp(4px, 1.5vh, 8px) 0 clamp(12px, 3vh, 16px);
  }

  .num-prefix {
    font-size: clamp(1.25rem, 4.5vw, 1.6rem);
    font-weight: 800;
    color: #64748b;
  }

  .ticket-num {
    font-size: clamp(3.2rem, 14vw, 4.4rem);
    font-weight: 900;
    color: #06c755;
    letter-spacing: -0.03em;
    line-height: 1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace, system-ui;
  }

  .live-clock-card {
    background: #0a0e17;
    border-radius: 8px;
    padding: clamp(8px, 2.5vw, 10px) clamp(10px, 3vw, 14px);
    margin-bottom: clamp(12px, 3vh, 16px);
    width: 100%;
  }

  .clock-label {
    font-size: clamp(0.58rem, 1.8vw, 0.65rem);
    color: #64748b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    display: block;
    margin-bottom: 2px;
    letter-spacing: 0.05em;
  }

  .clock-display {
    font-size: clamp(1.05rem, 4vw, 1.25rem);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
