const ALLOWED_ORIGINS = new Set([
  "https://shoko-guide.stki.org",
  "http://localhost:4321",
  "http://127.0.0.1:4321",
]);

// 枠あたりの定員数（15名）
const MAX_SLOT_CAPACITY = 15;

/* =========================================================
 * ユーティリティ & セキュリティ
 * ======================================================= */

function timingSafeEqual(a, b) {
  if (typeof a !== "string" || typeof b !== "string") return false;
  if (a.length !== b.length) return false;
  let result = 0;
  for (let i = 0; i < a.length; i++) {
    result |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return result === 0;
}

function normalizeOrigin(origin) {
  if (!origin || typeof origin !== "string") return null;
  return origin.trim().replace(/\/$/, "");
}

function isAllowedOrigin(origin) {
  if (!origin) return true;
  const norm = normalizeOrigin(origin);
  if (!norm) return false;

  // 1. 本番・ローカル固定ドメイン
  if (ALLOWED_ORIGINS.has(norm)) return true;

  // 2. StackBlitz / WebContainer / Localhost 開発ドメインを柔軟に許可
  if (
    norm.endsWith(".stackblitz.io") ||
    norm.endsWith(".webcontainer-api.io") ||
    norm.endsWith(".webcontainer.io") ||
    norm.includes("localhost") ||
    norm.includes("127.0.0.1")
  ) {
    return true;
  }

  return false;
}

function getCorsHeaders(origin) {
  const norm = normalizeOrigin(origin);
  const headers = {
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, X-Admin-Key, X-Admin-User, X-POS-User, X-POS-Key",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin",
  };

  if (norm && isAllowedOrigin(norm)) {
    headers["Access-Control-Allow-Origin"] = norm;
  } else {
    headers["Access-Control-Allow-Origin"] = "*";
  }

  return headers;
}

function jsonResponse(data, status = 200, origin = null, extraHeaders = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=UTF-8",
      "Cache-Control": "no-store",
      "X-Content-Type-Options": "nosniff",
      ...getCorsHeaders(origin),
      ...extraHeaders,
    },
  });
}

function errorResponse(message, status = 400, origin = null) {
  return jsonResponse({ success: false, message, error: message }, status, origin);
}

function handleOptions(request, origin) {
  const norm = normalizeOrigin(origin);
  const requestedHeaders =
    request.headers.get("Access-Control-Request-Headers") ||
    "Content-Type, X-Admin-Key, X-Admin-User, X-POS-User, X-POS-Key";

  return new Response(null, {
    status: 204,
    headers: {
      "Access-Control-Allow-Origin": norm && isAllowedOrigin(norm) ? norm : "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": requestedHeaders,
      "Access-Control-Max-Age": "86400",
      "Vary": "Origin",
    },
  });
}

function isNonEmptyString(value, maxLength = 2048) {
  return typeof value === "string" && value.length > 0 && value.length <= maxLength;
}

function isValidUserId(value) {
  return typeof value === "string" && value.length >= 1 && value.length <= 128 && !/[\u0000-\u001F\u007F]/.test(value);
}

async function readJson(request) {
  const contentType = request.headers.get("content-type") || "";
  if (!contentType.toLowerCase().includes("application/json")) {
    throw new Error("INVALID_CONTENT_TYPE");
  }

  const contentLength = Number(request.headers.get("content-length") || 0);
  if (Number.isFinite(contentLength) && contentLength > 32768) {
    throw new Error("BODY_TOO_LARGE");
  }

  return request.json();
}

/* =========================================================
 * システム稼働制御 (モジュール別 ON/OFF 判定)
 * ======================================================= */

async function getModuleStatus(env, key) {
  try {
    const res = await env.DB.prepare("SELECT value FROM system_settings WHERE key = ? LIMIT 1").bind(key).first();
    return !res || res.value === "1";
  } catch (e) {
    console.error(`Status check failed for ${key}:`, e);
    return true;
  }
}

async function getAllSystemStatus(env) {
  try {
    const { results } = await env.DB.prepare("SELECT key, value FROM system_settings").all();
    const map = new Map((results || []).map(r => [r.key, r.value === "1"]));
    return {
      admin_active: map.has("admin_active") ? map.get("admin_active") : true,
      issuance_active: map.has("issuance_active") ? map.get("issuance_active") : true,
      pos_active: map.has("pos_active") ? map.get("pos_active") : true,
    };
  } catch (e) {
    return { admin_active: true, issuance_active: true, pos_active: true };
  }
}

/* =========================================================
 * Cloudflare Turnstile & LINE ID Token 検証
 * ======================================================= */

async function verifyTurnstile(request, env, token) {
  // TURNSTILE_SECRET_KEY 未設定時はスキップ（安全なフォールバック）
  if (!env.TURNSTILE_SECRET_KEY) return { ok: true };
  if (!isNonEmptyString(token, 2048)) return { ok: false };

  const formData = new FormData();
  formData.append("secret", env.TURNSTILE_SECRET_KEY);
  formData.append("response", token);

  const remoteIp = request.headers.get("CF-Connecting-IP");
  if (remoteIp) formData.append("remoteip", remoteIp);

  try {
    const response = await fetch("https://challenges.cloudflare.com/turnstile/v0/siteverify", {
      method: "POST",
      body: formData,
    });

    if (!response.ok) return { ok: false };

    const result = await response.json();

    // 厳格な hostname チェックを排除し、Cloudflare 側の結果(result.success)のみを判定
    if (!result.success) {
      console.error("Turnstile verification failed error codes:", result["error-codes"]);
      return { ok: false };
    }

    return { ok: true };
  } catch (e) {
    console.error("Turnstile exception:", e);
    return { ok: false };
  }
}

async function verifyLineIdToken(idToken, env) {
  if (!env.LINE_CHANNEL_ID || !isNonEmptyString(idToken, 20000)) return null;

  const form = new URLSearchParams();
  form.set("id_token", idToken);
  form.set("client_id", env.LINE_CHANNEL_ID);

  try {
    const response = await fetch("https://api.line.me/oauth2/v2.1/verify", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: form.toString(),
    });

    if (!response.ok) return null;

    const claims = await response.json();
    if (claims.iss !== "https://access.line.me" || claims.aud !== env.LINE_CHANNEL_ID || !isValidUserId(claims.sub)) {
      return null;
    }

    const exp = Number(claims.exp);
    if (!Number.isFinite(exp) || exp * 1000 <= Date.now()) return null;

    return claims;
  } catch (e) {
    console.error("LINE verify exception:", e);
    return null;
  }
}

/* =========================================================
 * 整理券 DB 操作 & 枠情報・発券ハンドラ
 * ======================================================= */

async function getExistingActiveTicket(env, lineUserId, date, slotId) {
  if (!env.DB) throw new Error("D1_DATABASE_NOT_BOUND");

  return env.DB.prepare(`
    SELECT ticket_number, headcount, visitor_type, parent_name, participant_names, note, status
    FROM tickets
    WHERE line_user_id = ? AND date = ? AND slot_id = ? AND status != 'CANCELLED'
    ORDER BY id ASC
  `)
    .bind(lineUserId, date, slotId)
    .all();
}

async function issueTicket(env, lineUserId, date, slotId, headcount = 1, visitorType = "family", parentName = "", participantNames = "", note = "") {
  if (!env.DB) throw new Error("D1_DATABASE_NOT_BOUND");

  await env.DB.prepare(`
    INSERT INTO ticket_counter (id, next_number) VALUES (1, 1)
    ON CONFLICT(id) DO UPDATE SET next_number = next_number + 1
  `).run();

  const insertedRow = await env.DB.prepare(`
    INSERT INTO tickets (line_user_id, ticket_number, date, slot_id, headcount, visitor_type, parent_name, participant_names, note, status, created_at)
    SELECT ?, next_number, ?, ?, ?, ?, ?, ?, ?, 'WAITING', datetime('now')
    FROM ticket_counter
    WHERE id = 1
    RETURNING ticket_number
  `).bind(lineUserId, date, slotId, headcount, visitorType, parentName, participantNames, note).first();

  const ticketNumber = Number(insertedRow?.ticket_number);

  if (!Number.isInteger(ticketNumber) || ticketNumber < 1) {
    throw new Error("TICKET_COUNTER_ERROR");
  }

  return ticketNumber;
}

async function handleGetSlots(request, env, origin) {
  const url = new URL(request.url);
  const date = url.searchParams.get("date") || "2026-10-30";

  try {
    const isIssuanceActive = await getModuleStatus(env, "issuance_active");
    
    const { results } = await env.DB.prepare(`
      SELECT slot_id, COUNT(*) AS booked
      FROM tickets
      WHERE date = ? AND status != 'CANCELLED'
      GROUP BY slot_id
    `).bind(date).all();

    const bookedMap = new Map((results || []).map((r) => [r.slot_id, Number(r.booked)]));

    const slots = ["slot_1", "slot_2", "slot_3"].map((slotId) => {
      const booked = bookedMap.get(slotId) || 0;
      const remaining = Math.max(0, MAX_SLOT_CAPACITY - booked);
      return {
        slotId,
        booked,
        capacity: MAX_SLOT_CAPACITY,
        remaining,
        isFull: remaining <= 0,
      };
    });

    return jsonResponse({ success: true, isIssuanceActive, date, slots }, 200, origin);
  } catch (error) {
    console.error("Get slots error:", error);
    return errorResponse("枠情報の取得に失敗しました。", 500, origin);
  }
}

async function handleIssue(request, env, ctx, origin) {
  const isIssuanceActive = await getModuleStatus(env, "issuance_active");
  if (!isIssuanceActive) {
    return errorResponse("ただいま整理券（SPIKE体験会）の発券受付は停止しております。", 403, origin);
  }

  let body;
  try {
    body = await readJson(request);
  } catch {
    return errorResponse("JSONを読み取れませんでした。", 400, origin);
  }

  const date = String(body?.date || "").trim();
  const slotId = String(body?.slotId || "").trim();
  const visitorType = String(body?.visitorType || "family").trim();
  const headcount = Math.min(Math.max(Number(body?.headcount) || 1, 1), 15);
  const parentName = String(body?.parentName || "").slice(0, 100);
  const participantNames = String(body?.participantNames || "").slice(0, 500);
  const note = String(body?.note || "").slice(0, 200);

  if (!date || !slotId) return errorResponse("日付と時間枠を指定してください。", 400, origin);

  let lineUserId = null;
  const mockRequested = body && body.mockUserId !== undefined;

  if (mockRequested) {
    if (!isValidUserId(body.mockUserId)) {
      return errorResponse("mockUserIdが不正です。", 400, origin);
    }
    lineUserId = body.mockUserId;
  } else {
    const claims = await verifyLineIdToken(body?.idToken, env);
    if (!claims) return errorResponse("LINE認証を確認できませんでした。", 401, origin);

    lineUserId = claims.sub;

    const turnstileResult = await verifyTurnstile(request, env, body?.turnstileToken);
    if (!turnstileResult.ok) {
      return errorResponse("安全確認に失敗しました。もう一度お試しください。", 403, origin);
    }
  }

  try {
    const existingResult = await getExistingActiveTicket(env, lineUserId, date, slotId);
    const existingList = existingResult.results || [];
    if (existingList.length > 0) {
      const first = existingList[0];
      return jsonResponse({
        success: true,
        ticketNumber: Number(first.ticket_number),
        alreadyIssued: true,
      }, 200, origin);
    }

    const num = await issueTicket(env, lineUserId, date, slotId, headcount, visitorType, parentName, participantNames, note);

    return jsonResponse({
      success: true,
      ticketNumber: num,
      alreadyIssued: false,
    }, 200, origin);
  } catch (error) {
    console.error("Issue ticket error:", error);
    return errorResponse("発券に失敗しました。", 500, origin);
  }
}

/* =========================================================
 * 管理者認証 & GAS メール送信機能 API
 * ======================================================= */

function generate6DigitCode() {
  return String(Math.floor(100000 + Math.random() * 900000));
}

async function requireAdmin(request, env, origin) {
  const isAdminActive = await getModuleStatus(env, "admin_active");
  if (!isAdminActive) {
    return errorResponse("管理画面システムは現在停止中です。", 403, origin);
  }

  if (!env.ADMIN_SECRET_KEY) {
    return errorResponse("管理機能の設定が不足しています。", 500, origin);
  }

  const adminKey = request.headers.get("X-Admin-Key");
  const adminUser = request.headers.get("X-Admin-User");

  if (!adminKey || !timingSafeEqual(adminKey, env.ADMIN_SECRET_KEY)) {
    return errorResponse("合言葉（パスワード）が正しくありません。", 401, origin);
  }

  if (!adminUser || typeof adminUser !== "string") {
    return errorResponse("管理者アカウント情報が不足しています。", 401, origin);
  }

  const normalizedEmail = adminUser.trim().toLowerCase();
  try {
    const adminRecord = await env.DB.prepare(
      "SELECT id, email, name FROM admin_users WHERE lower(email) = ? AND is_active = 1 LIMIT 1"
    ).bind(normalizedEmail).first();

    if (!adminRecord) {
      return errorResponse("登録または有効化されていない管理者アカウントです。", 403, origin);
    }
  } catch (err) {
    console.error("Admin DB auth check failed:", err);
    return errorResponse("認証処理中にエラーが発生しました。", 500, origin);
  }

  return null;
}

async function handleAdminSendAuthCode(request, env, origin) {
  let body;
  try {
    body = await readJson(request);
  } catch {
    return errorResponse("リクエスト形式が不正です。", 400, origin);
  }

  const email = String(body?.email || "").trim().toLowerCase();
  if (!email || !email.includes("@")) {
    return errorResponse("有効なメールアドレスを入力してください。", 400, origin);
  }

  const adminRecord = await env.DB.prepare(
    "SELECT id, email, name FROM admin_users WHERE lower(email) = ? AND is_active = 1 LIMIT 1"
  ).bind(email).first();

  if (!adminRecord) {
    return errorResponse("登録されているスタッフ用のメールアドレスではありません。", 403, origin);
  }

  const code = generate6DigitCode();

  try {
    await env.DB.prepare(`
      INSERT INTO admin_auth_codes (email, code, expires_at)
      VALUES (?, ?, datetime('now', '+10 minutes'))
      ON CONFLICT(email) DO UPDATE SET
        code = excluded.code,
        expires_at = excluded.expires_at
    `).bind(email, code).run();
  } catch (e) {
    await env.DB.prepare(`
      CREATE TABLE IF NOT EXISTS admin_auth_codes (
        email TEXT PRIMARY KEY,
        code TEXT NOT NULL,
        expires_at DATETIME NOT NULL
      )
    `).run();

    await env.DB.prepare(`
      INSERT INTO admin_auth_codes (email, code, expires_at)
      VALUES (?, ?, datetime('now', '+10 minutes'))
      ON CONFLICT(email) DO UPDATE SET
        code = excluded.code,
        expires_at = excluded.expires_at
    `).bind(email, code).run();
  }

  if (!env.GAS_WEBAPP_URL) {
    return errorResponse("メール送信連携の設定（GAS_WEBAPP_URL）が見つかりません。", 500, origin);
  }

  try {
    const gasRes = await fetch(env.GAS_WEBAPP_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        action: "send_auth_code",
        email: email,
        name: adminRecord.name,
        code: code,
        secret: env.GAS_SHARED_SECRET
      })
    });

    if (!gasRes.ok) {
      console.error("GAS Email Response Error:", await gasRes.text());
      return errorResponse("GASでのメール送信処理に失敗しました。", 500, origin);
    }
  } catch (e) {
    console.error("GAS Fetch Error:", e);
    return errorResponse("メール送信サーバーへの接続に失敗しました。", 500, origin);
  }

  return jsonResponse({
    success: true,
    message: "認証コードをメール送信しました。"
  }, 200, origin);
}

async function handleAdminVerifyAuthCode(request, env, origin) {
  let body;
  try {
    body = await readJson(request);
  } catch {
    return errorResponse("リクエスト形式が不正です。", 400, origin);
  }

  const email = String(body?.email || "").trim().toLowerCase();
  const code = String(body?.code || "").trim();

  if (!email || !code) {
    return errorResponse("メールアドレスと認証コードを入力してください。", 400, origin);
  }

  const adminRecord = await env.DB.prepare(
    "SELECT id, email, name FROM admin_users WHERE lower(email) = ? AND is_active = 1 LIMIT 1"
  ).bind(email).first();

  if (!adminRecord) {
    return errorResponse("登録されているスタッフアカウントではありません。", 403, origin);
  }

  const savedCodeRow = await env.DB.prepare(`
    SELECT code FROM admin_auth_codes
    WHERE lower(email) = ? AND code = ? AND expires_at > datetime('now')
    LIMIT 1
  `).bind(email, code).first();

  if (!savedCodeRow) {
    return errorResponse("認証コードが正しくないか、有効期限（10分）が切れています。", 400, origin);
  }

  await env.DB.prepare("DELETE FROM admin_auth_codes WHERE lower(email) = ?").bind(email).run();

  return jsonResponse({
    success: true,
    email: adminRecord.email,
    name: adminRecord.name,
    adminKey: env.ADMIN_SECRET_KEY
  }, 200, origin);
}

async function handleAdminUpdateStatus(request, env, origin) {
  const authError = await requireAdmin(request, env, origin);
  if (authError) return authError;

  let body;
  try {
    body = await readJson(request);
  } catch {
    return errorResponse("リクエスト形式が不正です。", 400, origin);
  }

  const ticketNumber = Number(body?.ticketNumber);
  const status = String(body?.status || "").trim();

  if (!ticketNumber || !["WAITING", "CALLED", "ADMITTED", "CANCELLED"].includes(status)) {
    return errorResponse("無効なパラメータです。", 400, origin);
  }

  try {
    const result = await env.DB.prepare(`
      UPDATE tickets
      SET status = ?
      WHERE ticket_number = ?
    `).bind(status, ticketNumber).run();

    if (result.meta.changes === 0) {
      return errorResponse("指定された整理券が見つかりません。", 404, origin);
    }

    return jsonResponse({ success: true, message: "ステータスを更新しました。" }, 200, origin);
  } catch (err) {
    console.error("Update status error:", err);
    return errorResponse("ステータスの更新に失敗しました。", 500, origin);
  }
}

async function handleAdminGetSystemControl(request, env, origin) {
  const status = await getAllSystemStatus(env);
  return jsonResponse({ success: true, status }, 200, origin);
}

async function handleAdminUpdateSystemControl(request, env, origin) {
  let body;
  try {
    body = await readJson(request);
  } catch {
    return errorResponse("リクエスト形式が不正です。", 400, origin);
  }

  const { target, active, secret } = body;

  if (secret && secret !== env.GAS_SHARED_SECRET) {
    return errorResponse("認証キーが正しくありません。", 401, origin);
  }

  const val = active ? "1" : "0";
  const validKeys = new Set(["admin_active", "issuance_active", "pos_active"]);

  try {
    if (target === "all") {
      await env.DB.batch([
        env.DB.prepare("INSERT INTO system_settings (key, value) VALUES ('admin_active', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value").bind(val),
        env.DB.prepare("INSERT INTO system_settings (key, value) VALUES ('issuance_active', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value").bind(val),
        env.DB.prepare("INSERT INTO system_settings (key, value) VALUES ('pos_active', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value").bind(val),
      ]);
    } else if (validKeys.has(target)) {
      await env.DB.prepare("INSERT INTO system_settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value").bind(target, val).run();
    } else {
      return errorResponse("指定された制御対象が存在しません。", 400, origin);
    }

    const currentStatus = await getAllSystemStatus(env);
    return jsonResponse({ success: true, status: currentStatus, message: "稼働状態を更新しました。" }, 200, origin);
  } catch (err) {
    console.error("Update system control error:", err);
    return errorResponse("稼働状態の更新に失敗しました。", 500, origin);
  }
}

async function handleAdminList(request, env, origin) {
  const authError = await requireAdmin(request, env, origin);
  if (authError) return authError;

  const url = new URL(request.url);
  const rawLimit = Number(url.searchParams.get("limit") || 100);
  const limit = Number.isInteger(rawLimit) ? Math.min(Math.max(rawLimit, 1), 200) : 100;

  try {
    const [rows, total, waiting, called, admitted] = await Promise.all([
      env.DB.prepare(`
        SELECT id, ticket_number, date, slot_id, headcount, visitor_type, parent_name, participant_names, note, line_user_id, status, created_at
        FROM tickets
        ORDER BY id DESC
        LIMIT ?
      `).bind(limit).all(),
      env.DB.prepare("SELECT COUNT(*) AS count FROM tickets").first(),
      env.DB.prepare("SELECT COUNT(*) AS count FROM tickets WHERE status = 'WAITING'").first(),
      env.DB.prepare("SELECT COUNT(*) AS count FROM tickets WHERE status = 'CALLED'").first(),
      env.DB.prepare("SELECT COUNT(*) AS count FROM tickets WHERE status = 'ADMITTED'").first(),
    ]);

    return jsonResponse(
      {
        success: true,
        tickets: rows.results || [],
        stats: {
          total: Number(total?.count || 0),
          waiting: Number(waiting?.count || 0),
          called: Number(called?.count || 0),
          admitted: Number(admitted?.count || 0),
        },
      },
      200,
      origin
    );
  } catch (error) {
    console.error("Admin list failed:", error);
    return errorResponse("一覧を取得できませんでした。", 500, origin);
  }
}

/* =========================================================
 * Worker Main ルーティング
 * ======================================================= */

export default {
  async fetch(request, env, ctx) {
    const origin = request.headers.get("Origin");

    try {
      const url = new URL(request.url);

      if (request.method === "OPTIONS") {
        return handleOptions(request, origin);
      }

      if (!isAllowedOrigin(origin)) {
        return errorResponse("許可されていないアクセス元です。", 403, origin);
      }

      if (request.method === "GET" && url.pathname === "/") {
        return jsonResponse({ success: true, service: "shokosai-portal-api", status: "online" }, 200, origin);
      }

      if (request.method === "POST" && url.pathname === "/admin/send-auth-code") {
        return await handleAdminSendAuthCode(request, env, origin);
      }

      if (request.method === "POST" && url.pathname === "/admin/verify-auth-code") {
        return await handleAdminVerifyAuthCode(request, env, origin);
      }

      if (request.method === "POST" && url.pathname === "/admin/update-status") {
        return await handleAdminUpdateStatus(request, env, origin);
      }

      if (request.method === "GET" && url.pathname === "/admin/system-control") {
        return await handleAdminGetSystemControl(request, env, origin);
      }

      if (request.method === "POST" && url.pathname === "/admin/system-control") {
        return await handleAdminUpdateSystemControl(request, env, origin);
      }

      if (request.method === "GET" && url.pathname === "/api/slots") {
        return await handleGetSlots(request, env, origin);
      }

      if (request.method === "POST" && url.pathname === "/") {
        return await handleIssue(request, env, ctx, origin);
      }

      if (request.method === "GET" && url.pathname === "/admin/list") {
        return await handleAdminList(request, env, origin);
      }

      return errorResponse("Not Found", 404, origin);
    } catch (error) {
      console.error("Unhandled Worker Error:", error);
      return errorResponse("サーバー内部エラーが発生しました。", 500, origin);
    }
  },
};
